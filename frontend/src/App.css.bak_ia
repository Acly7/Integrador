  display: block;
  color: #1f1724;
  font-size: 14px;
  line-height: 1.35;
}

.cliente-notification-item p,
.empresa-notification-item p,
.cliente-notification-empty,
.empresa-notification-empty {
  margin: 5px 0 0;
  color: #706878;
  font-size: 13px;
  line-height: 1.5;
}

.cliente-notification-item.ok,
.empresa-notification-item.ok {
  background: #ecfdf3;
  border-color: #bbf7d0;
}

.cliente-notification-item.revision,
.empresa-notification-item.revision,
.empresa-notification-item.nuevo {
  background: #fffbeb;
  border-color: #fde68a;
}

.cliente-notification-item.error,
.empresa-notification-item.error {
  background: #fff1f2;
  border-color: #fecdd3;
}

.cliente-notification-link {
  width: 100%;
  margin-top: 12px;
  border: none;
  border-radius: 15px;
  padding: 12px 14px;
  background: linear-gradient(135deg, #8f174d, #c02672);
  color: white;
  font-weight: 900;
  cursor: pointer;
}

/* NOTIFICACIONES EMPRESA */

.empresa-top-actions {
  display: flex;
  align-items: center;
  gap: 12px;
  position: relative;
}

.empresa-notification-area {
  position: relative;
}

.empresa-notification-top {
  position: relative;
  width: 48px;
  height: 48px;
  border: 1px solid #eadce5;
  border-radius: 16px;
  background: rgba(255, 255, 255, 0.96);
  color: #8f174d;
  display: grid;
  place-items: center;
  cursor: pointer;
  box-shadow: 0 12px 28px rgba(55, 19, 43, 0.1);
}

.empresa-notification-top:hover {
  background: #fff1f7;
  transform: translateY(-1px);
}

.empresa-notification-top span {
  position: absolute;
  top: -7px;
  right: -7px;
  min-width: 22px;
  height: 22px;
  padding: 0 6px;
  border-radius: 999px;
  background: linear-gradient(135deg, #8f174d, #c02672);
  color: white;
  display: grid;
  place-items: center;
  font-size: 11px;
  font-weight: 900;
}

.empresa-notification-actions {
  display: flex;
  gap: 8px;
  margin-top: 12px;
}

.empresa-notification-actions button,
.empresa-header-actions-mini button {
  border: none;
  border-radius: 12px;
  padding: 9px 12px;
  background: #f2edf1;
  color: #3e3542;
  font-size: 12px;
  font-weight: 900;
  cursor: pointer;
}

.empresa-notification-actions button:first-child,
.empresa-header-actions-mini button:first-child {
  background: #fff1f7;
  color: #8f174d;
}

.empresa-header-actions-mini {
  display: flex;
  gap: 8px;
  flex-wrap: wrap;
  justify-content: flex-end;
}

@media (max-width: 960px) {
  .portal-panel.menu-contraido,
  .empresa-panel.menu-contraido,
  .portal-panel,
  .empresa-panel {
    grid-template-columns: 1fr;
  }

  .portal-menu-toggle,
  .empresa-menu-toggle {
    right: 18px;
  }

  .cliente-top-actions {
    top: 22px;
    right: 22px;
  }

  .cliente-notification-popover {
    right: -66px;
  }
}


/* ===== NOTIFICACIONES LEÍDAS / NUEVAS ===== */

.cliente-notification-item.sin-leer,
.empresa-notification-item.sin-leer {
  border-width: 2px;
  box-shadow: 0 12px 28px rgba(143, 23, 77, 0.12);
}

.cliente-notification-item.sin-leer strong,
.empresa-notification-item.sin-leer strong {
  font-weight: 950;
  color: #8f174d;
}

.cliente-notification-item.sin-leer p,
.empresa-notification-item.sin-leer p {
  font-weight: 800;
  color: #3e3542;
}

.cliente-top-actions {
  position: fixed !important;
  top: 76px;
  right: 34px;
  z-index: 90;
}

@media (max-width: 960px) {
  .cliente-top-actions {
    top: 22px;
    right: 22px;
  }
}

/* ===== MIS PEDIDOS: PRODUCTOS CLICKEABLES PARA VER DETALLE ===== */

.cliente-pedido-producto-boton {
  width: 100%;
  border: none;
  text-align: left;
  cursor: pointer;
  transition: 0.2s ease;
}

.cliente-pedido-producto-boton:hover {
  background: #fff1f7;
  transform: translateY(-1px);
  box-shadow: 0 10px 24px rgba(143, 23, 77, 0.08);
}

.cliente-pedido-producto-boton:focus-visible {
  outline: 3px solid rgba(143, 23, 77, 0.22);
  outline-offset: 2px;
}

.cliente-pedido-producto-info {
  display: grid;
  gap: 5px;
}

.cliente-pedido-producto-info strong {
  color: #1f1724;
}

.cliente-pedido-producto-info small {
  color: #706878;
  font-size: 13px;
  font-weight: 800;
}

.cliente-pedido-producto-precio {
  color: #8f174d;
  font-weight: 900;
  white-space: nowrap;
}

/* ===== MI CUENTA CLIENTE ===== */

.cliente-cuenta-page {
  display: grid;
  gap: 22px;
}

.cliente-cuenta-header {
  padding: 26px;
  border-radius: 28px;
  background: white;
  border: 1px solid #eadce5;
  display: flex;
  justify-content: space-between;
  align-items: center;
  gap: 18px;
  box-shadow: 0 16px 38px rgba(55, 19, 43, 0.06);
}

.cliente-cuenta-header span,
.cliente-cuenta-card span,
.cliente-cuenta-perfil span,
.cliente-password-box span {
  color: #8f174d;
  font-size: 12px;
  font-weight: 900;
  text-transform: uppercase;
  letter-spacing: 1px;
}

.cliente-cuenta-header h2 {
  margin: 7px 0 6px;
  color: #1f1724;
  font-size: 32px;
}

.cliente-cuenta-header p,
.cliente-cuenta-card p,
.cliente-cuenta-perfil p,
.cliente-password-box p,
.cliente-cuenta-foto-box p {
  margin: 0;
  color: #706878;
  line-height: 1.6;
}

.cliente-cuenta-header button {
  border: none;
  border-radius: 15px;
  padding: 13px 18px;
  background: linear-gradient(135deg, #8f174d, #c02672);
  color: white;
  font-weight: 900;
  cursor: pointer;
}

.cliente-cuenta-grid {
  display: grid;
  grid-template-columns: 1.2fr 1fr 1fr;
  gap: 18px;
}

.cliente-cuenta-perfil,
.cliente-cuenta-card,
.cliente-cuenta-form {
  background: white;
  border: 1px solid #eadce5;
  border-radius: 26px;
  padding: 24px;
  box-shadow: 0 16px 38px rgba(55, 19, 43, 0.06);
}

.cliente-cuenta-perfil {
  grid-row: span 2;
}

.cliente-cuenta-avatar {
  width: 74px;
  height: 74px;
  border-radius: 24px;
  background: linear-gradient(135deg, #8f174d, #e879b4);
  color: white;
  display: grid;
  place-items: center;
  overflow: hidden;
  box-shadow: 0 14px 30px rgba(143, 23, 77, 0.18);
  margin-bottom: 18px;
}

.cliente-cuenta-avatar.grande {
  width: 150px;
  height: 150px;
  border-radius: 34px;
}

.cliente-cuenta-avatar span {
  color: white;
  font-size: 42px;
  font-weight: 900;
  letter-spacing: 0;
}

.cliente-cuenta-avatar img {
  width: 100%;
  height: 100%;
  object-fit: cover;
}

.cliente-cuenta-perfil h3 {
  margin: 10px 0;
  color: #1f1724;
  font-size: 30px;
}

.cliente-cuenta-card strong {
  display: block;
  margin: 11px 0 6px;
  color: #1f1724;
  font-size: 20px;
}

.cliente-cuenta-editor-layout {
  display: grid;
  grid-template-columns: 250px 1fr;
  gap: 24px;
}

.cliente-cuenta-foto-box {
  padding: 20px;
  border-radius: 24px;
  background: #fff1f7;
  border: 1px solid #f8cfe1;
  height: fit-content;
}

.cliente-cuenta-foto-box label {
  display: block;
  margin-bottom: 10px;
  color: #8f174d;
  font-weight: 900;
}

.cliente-cuenta-foto-box input {
  width: 100%;
  padding: 11px;
  border-radius: 14px;
  border: 1px dashed #e879b4;
  background: white;
}

.cliente-cuenta-foto-box p {
  margin-top: 12px;
  font-size: 13px;
}

.cliente-cuenta-campos {
  display: grid;
  gap: 16px;
}

.cliente-password-box,
.cliente-password-panel {
  padding: 18px;
  border-radius: 22px;
  background: #faf7fb;
  border: 1px solid #eadce5;
}

.cliente-password-box {
  display: flex;
  justify-content: space-between;
  align-items: center;
  gap: 16px;
}

.cliente-password-box h3 {
  margin: 6px 0;
  color: #1f1724;
}

.cliente-password-panel {
  display: grid;
  gap: 16px;
}

@media (max-width: 950px) {
  .cliente-cuenta-grid,
  .cliente-cuenta-editor-layout {
    grid-template-columns: 1fr;
  }

  .cliente-cuenta-perfil {
    grid-row: auto;
  }

  .cliente-password-box,
  .cliente-cuenta-header {
    flex-direction: column;
    align-items: flex-start;
  }
}


/* =========================================================
   PANEL ADMINISTRATIVO ZYRA
   ========================================================= */

.admin-page {
  display: grid;
  gap: 22px;
}

.admin-top-actions {
  position: fixed;
  top: 78px;
  right: 34px;
  z-index: 90;
}

.admin-bell {
  position: relative;
  width: 54px;
  height: 54px;
  border: 1px solid #eadce5;
  border-radius: 18px;
  background: rgba(255, 255, 255, 0.96);
  color: #8f174d;
  display: grid;
  place-items: center;
  cursor: pointer;
  box-shadow: 0 14px 35px rgba(55, 19, 43, 0.14);
}

.admin-bell svg {
  width: 24px;
  height: 24px;
}

.admin-bell > span {
  position: absolute;
  top: -7px;
  right: -7px;
  min-width: 24px;
  height: 24px;
  padding: 0 7px;
  border-radius: 999px;
  background: linear-gradient(135deg, #8f174d, #c02672);
  color: #fff;
  display: grid;
  place-items: center;
  font-size: 12px;
  font-weight: 900;
}

.admin-notificaciones-popover {
  position: absolute;
  top: 64px;
  right: 0;
  width: 370px;
  padding: 18px;
  border-radius: 24px;
  background: rgba(255, 255, 255, 0.98);
  border: 1px solid #eadce5;
  box-shadow: 0 28px 70px rgba(55, 19, 43, 0.2);
}

.admin-popover-close {
  position: absolute;
  top: 12px;
  right: 12px;
  width: 32px;
  height: 32px;
  border: none;
  border-radius: 999px;
  background: #fff1f2;
  color: #be123c;
  display: grid;
  place-items: center;
  cursor: pointer;
}

.admin-popover-close svg {
  width: 18px;
  height: 18px;
}

.admin-notificaciones-popover > span,
.admin-hero span,
.admin-section-header span,
.admin-panel-title span,
.admin-metrica span,
.admin-info-lista span,
.admin-ticket-card > span {
  color: #8f174d;
  font-size: 12px;
  font-weight: 900;
  text-transform: uppercase;
  letter-spacing: 1px;
}

.admin-notificaciones-popover h3 {
  margin: 6px 0 14px;
  color: #1f1724;
}

.admin-notificaciones-lista {
  display: grid;
  gap: 10px;
}

.admin-notificacion-item {
  width: 100%;
  border: 1px solid #eadce5;
  border-radius: 18px;
  padding: 13px;
  text-align: left;
  background: #faf7fb;
  cursor: pointer;
}

.admin-notificacion-item.warning {
  background: #fffbeb;
  border-color: #fde68a;
}

.admin-notificacion-item.info {
  background: #eef2ff;
  border-color: #c7d2fe;
}

.admin-notificacion-item.alerta {
  background: #fff1f2;
  border-color: #fecdd3;
}

.admin-notificacion-item strong {
  display: block;
  color: #1f1724;
  margin-bottom: 5px;
}

.admin-notificacion-item p,
.admin-notificacion-vacia {
  margin: 0;
  color: #706878;
  line-height: 1.45;
}

.admin-hero {
  display: grid;
  grid-template-columns: 1fr 280px;
  gap: 22px;
  padding: 32px;
  border-radius: 30px;
  background:
    radial-gradient(circle at 90% 10%, rgba(255, 255, 255, 0.22), transparent 28%),
    linear-gradient(135deg, #8f174d, #c02672 58%, #e879b4);
  color: white;
  box-shadow: 0 24px 60px rgba(143, 23, 77, 0.22);
}

.admin-hero span,
.admin-hero p {
  color: white;
}

.admin-hero h2 {
  margin: 10px 0;
  font-family: "Playfair Display", serif;
  font-size: clamp(34px, 4vw, 52px);
  line-height: 0.98;
}

.admin-hero p {
  max-width: 690px;
  margin: 0;
  line-height: 1.65;
  opacity: 0.92;
}

.admin-hero-mini {
  display: grid;
  gap: 8px;
  align-content: center;
  padding: 22px;
  border-radius: 24px;
  background: rgba(255, 255, 255, 0.18);
  border: 1px solid rgba(255, 255, 255, 0.25);
}

.admin-hero-mini strong {
  font-size: 36px;
  line-height: 1;
}

.admin-metricas-grid {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 18px;
}

.admin-metrica,
.admin-panel-card,
.admin-section-header,
.admin-empresa-card,
.admin-tabla-card,
.admin-producto-card,
.admin-pedido-card,
.admin-pago-card,
.admin-ticket-card,
.admin-vacio-card,
.admin-error-box,
.admin-cargando-box {
  background: white;
  border: 1px solid #eadce5;
  border-radius: 24px;
  box-shadow: 0 14px 35px rgba(55, 19, 43, 0.06);
}

.admin-metrica {
  padding: 22px;
}

.admin-metrica.principal {
  background: linear-gradient(135deg, #8f174d, #c02672);
  color: white;
}

.admin-metrica.warning {
  background: #fffbeb;
  border-color: #fde68a;
}

.admin-metrica.info {
  background: #eef2ff;
  border-color: #c7d2fe;
}

.admin-metrica.alerta {
  background: #fff1f2;
  border-color: #fecdd3;
}

.admin-metrica.principal span,
.admin-metrica.principal strong,
.admin-metrica.principal p {
  color: white;
}

.admin-metrica strong {
  display: block;
  margin: 10px 0 6px;
  color: #1f1724;
  font-size: 32px;
}

.admin-metrica p {
  margin: 0;
  color: #706878;
  line-height: 1.5;
}

.admin-dos-columnas {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 18px;
}

.admin-panel-card,
.admin-section-header {
  padding: 22px;
}

.admin-panel-title h3,
.admin-section-header h2 {
  margin: 6px 0 0;
  color: #1f1724;
  font-size: 24px;
}

.admin-section-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  gap: 18px;
}

.admin-section-header button,
.admin-acciones-rapidas button,
.admin-empresa-acciones button,
.admin-pago-acciones button,
.admin-filtros-pills button {
  border: none;
  border-radius: 14px;
  padding: 11px 14px;
  font-weight: 900;
  cursor: pointer;
}

.admin-section-header button,
.admin-acciones-rapidas button,
.admin-pago-acciones button {
  background: #fff1f7;
  color: #8f174d;
}

.admin-acciones-rapidas {
  display: flex;
  flex-wrap: wrap;
  gap: 10px;
  margin-top: 18px;
}

.admin-estado-plataforma {
  display: grid;
  gap: 10px;
  margin-top: 18px;
}

.admin-estado-plataforma div,
.admin-info-lista div {
  padding: 13px;
  border-radius: 16px;
  background: #faf7fb;
}

.admin-estado-plataforma span,
.admin-info-lista span {
  display: block;
  margin-bottom: 5px;
}

.admin-estado-plataforma strong,
.admin-info-lista strong {
  color: #1f1724;
}

.admin-filtros-pills {
  display: flex;
  gap: 10px;
  flex-wrap: wrap;
}

.admin-filtros-pills button {
  background: #f2edf1;
  color: #5f5264;
}

.admin-filtros-pills button.activo {
  background: #8f174d;
  color: white;
}

.admin-empresas-grid {
  display: grid;
  grid-template-columns: repeat(auto-fill, minmax(330px, 1fr));
  gap: 18px;
}

.admin-empresa-card,
.admin-ticket-card,
.admin-pedido-card,
.admin-pago-card {
  padding: 20px;
  display: grid;
  gap: 15px;
}

.admin-empresa-top,
.admin-pedido-top {
  display: flex;
  justify-content: space-between;
  align-items: flex-start;
  gap: 14px;
}

.admin-avatar {
  width: 58px;
  height: 58px;
  border-radius: 20px;
  overflow: hidden;
  display: grid;
  place-items: center;
  background: linear-gradient(135deg, #8f174d, #e879b4);
  color: white;
  font-weight: 900;
  font-size: 24px;
}

.admin-avatar img {
  width: 100%;
  height: 100%;
  object-fit: cover;
}

.admin-empresa-card h3,
.admin-ticket-card h3,
.admin-pedido-card h3,
.admin-pago-card h3 {
  margin: 0;
  color: #1f1724;
  font-size: 22px;
}

.admin-empresa-card p,
.admin-ticket-card p,
.admin-pedido-card p,
.admin-pago-card p {
  margin: 0;
  color: #706878;
  line-height: 1.5;
}

.admin-info-lista {
  display: grid;
  grid-template-columns: repeat(2, 1fr);
  gap: 10px;
}

.admin-info-lista.compacta {
  grid-template-columns: repeat(3, 1fr);
}

.admin-empresa-acciones,
.admin-pago-acciones {
  display: flex;
  gap: 9px;
  flex-wrap: wrap;
}

.admin-empresa-acciones button.aprobar {
  background: #ecfdf3;
  color: #15803d;
}

.admin-empresa-acciones button.deshabilitar {
  background: #fff1f2;
  color: #be123c;
}

.admin-empresa-acciones button.pendiente {
  background: #fffbeb;
  color: #b45309;
}

.admin-estado-badge {
  display: inline-flex;
  width: fit-content;
  align-items: center;
  justify-content: center;
  padding: 8px 11px;
  border-radius: 999px;
  background: #f2edf1;
  color: #5f5264;
  font-size: 11px;
  font-weight: 900;
  text-transform: uppercase;
}

.admin-estado-badge.APROBADA,
.admin-estado-badge.ACTIVO,
.admin-estado-badge.PAGADO,
.admin-estado-badge.CERRADO,
.admin-estado-badge.ENTREGADO {
  background: #ecfdf3;
  color: #15803d;
}

.admin-estado-badge.PENDIENTE,
.admin-estado-badge.EN_REVISION,
.admin-estado-badge.CONFIRMADO {
  background: #fffbeb;
  color: #b45309;
}

.admin-estado-badge.DESHABILITADA,
.admin-estado-badge.RECHAZADO,
.admin-estado-badge.CANCELADO {
  background: #fff1f2;
  color: #be123c;
}

.admin-tabla-card {
  overflow-x: auto;
}

.admin-tabla {
  width: 100%;
  border-collapse: collapse;
  min-width: 800px;
}

.admin-tabla th,
.admin-tabla td {
  padding: 15px;
  border-bottom: 1px solid #f2dce7;
  text-align: left;
}

.admin-tabla th {
  color: #8f174d;
  font-size: 12px;
  text-transform: uppercase;
}

.admin-user-cell {
  display: flex;
  align-items: center;
  gap: 12px;
}

.admin-user-cell .admin-avatar {
  width: 42px;
  height: 42px;
  border-radius: 14px;
  font-size: 18px;
}

.admin-productos-grid {
  display: grid;
  grid-template-columns: repeat(auto-fill, minmax(235px, 1fr));
  gap: 18px;
}

.admin-producto-card {
  overflow: hidden;
}

.admin-producto-img {
  height: 210px;
  display: grid;
  place-items: center;
  background: #fff1f7;
  color: #8f174d;
  font-weight: 900;
}

.admin-producto-img img {
  width: 100%;
  height: 100%;
  object-fit: cover;
}

.admin-producto-info {
  padding: 16px;
}

.admin-producto-info > span {
  color: #8f174d;
  font-size: 11px;
  font-weight: 900;
  text-transform: uppercase;
}

.admin-producto-info h3 {
  margin: 8px 0 5px;
  color: #1f1724;
}

.admin-producto-info p,
.admin-producto-info small {
  color: #706878;
}

.admin-producto-meta {
  display: flex;
  justify-content: space-between;
  align-items: center;
  gap: 10px;
  margin: 12px 0;
}

.admin-producto-meta strong {
  color: #8f174d;
  font-size: 18px;
}

.admin-lista {
  display: grid;
  gap: 16px;
}

.admin-pedido-estados {
  display: flex;
  gap: 8px;
  flex-wrap: wrap;
  justify-content: flex-end;
}

.admin-items-lista {
  display: grid;
  gap: 10px;
}

.admin-items-lista div {
  display: grid;
  grid-template-columns: 1fr auto;
  gap: 8px 14px;
  padding: 13px;
  border-radius: 16px;
  background: #faf7fb;
}

.admin-items-lista p {
  grid-column: 1 / -1;
}

.admin-items-lista span {
  color: #8f174d;
  font-weight: 900;
}

.admin-pago-acciones span {
  padding: 11px 14px;
  border-radius: 14px;
  background: #f2edf1;
  color: #706878;
  font-weight: 900;
}

.admin-error-box,
.admin-cargando-box,
.admin-vacio-card {
  padding: 20px;
}

.admin-error-box {
  background: #fff1f2;
  color: #be123c;
  border-color: #fecdd3;
  font-weight: 900;
}

.admin-cargando-box {
  color: #8f174d;
  font-weight: 900;
}

.admin-vacio-card h3 {
  margin-top: 0;
  color: #1f1724;
}

.admin-imagen-modal {
  position: fixed;
  inset: 0;
  z-index: 1200;
  background: rgba(15, 12, 18, 0.82);
  display: grid;
  place-items: center;
  padding: 28px;
}

.admin-imagen-modal button {
  position: fixed;
  top: 20px;
  right: 22px;
  width: 44px;
  height: 44px;
  border: none;
  border-radius: 999px;
  background: white;
  color: #be123c;
  font-size: 28px;
  font-weight: 900;
  cursor: pointer;
}

.admin-imagen-modal img {
  max-width: min(980px, 94vw);
  max-height: 86vh;
  border-radius: 22px;
  object-fit: contain;
  background: white;
}

@media (max-width: 1000px) {
  .admin-hero,
  .admin-metricas-grid,
  .admin-dos-columnas,
  .admin-info-lista.compacta {
    grid-template-columns: 1fr;
  }

  .admin-info-lista {
    grid-template-columns: 1fr;
  }

  .admin-top-actions {
    top: 22px;
    right: 22px;
  }

  .admin-notificaciones-popover {
    width: min(360px, calc(100vw - 36px));
  }
}



/* =========================================================
   ADMIN ZIP 1: listas ordenadas, usuarios y cuenta admin
   ========================================================= */

.admin-scroll-grid {
  max-height: calc(100vh - 230px);
  overflow-y: auto;
  padding-right: 6px;
}

.admin-scroll-grid::-webkit-scrollbar,
.admin-usuarios-scroll::-webkit-scrollbar,
.admin-productos-scroll::-webkit-scrollbar {
  width: 7px;
}

.admin-scroll-grid::-webkit-scrollbar-thumb,
.admin-usuarios-scroll::-webkit-scrollbar-thumb,
.admin-productos-scroll::-webkit-scrollbar-thumb {
  background: rgba(143, 23, 77, 0.22);
  border-radius: 999px;
}

.admin-usuarios-grupos-grid {
  display: grid;
  grid-template-columns: repeat(3, minmax(0, 1fr));
  gap: 18px;
  align-items: start;
}

.admin-usuarios-grupo,
.admin-categoria-admin,
.admin-cuenta-principal,
.admin-cuenta-card,
.admin-cuenta-form,
.admin-password-form,
.admin-empresa-selector-card {
  background: rgba(255, 255, 255, 0.96);
  border: 1px solid #eadce5;
  border-radius: 24px;
  box-shadow: 0 14px 35px rgba(55, 19, 43, 0.06);
}

.admin-usuarios-grupo {
  overflow: hidden;
}

.admin-grupo-header,
.admin-categoria-titulo {
  padding: 18px;
  border-bottom: 1px solid #f2dce7;
  display: flex;
  justify-content: space-between;
  align-items: center;
  gap: 14px;
  background: linear-gradient(135deg, #fff7fb, #ffffff);
}

.admin-grupo-header span,
.admin-categoria-titulo span,
.admin-cuenta-principal span,
.admin-cuenta-card span,
.admin-detalle-modal > span {
  color: #8f174d;
  font-size: 11px;
  font-weight: 900;
  text-transform: uppercase;
  letter-spacing: 1px;
}

.admin-grupo-header h3,
.admin-categoria-titulo h3 {
  margin: 5px 0 0;
  color: #1f1724;
  font-size: 20px;
}

.admin-grupo-header strong,
.admin-categoria-titulo strong {
  min-width: 40px;
  height: 40px;
  border-radius: 14px;
  display: grid;
  place-items: center;
  background: #fff1f7;
  color: #8f174d;
  font-weight: 900;
}

.admin-usuarios-scroll {
  max-height: 520px;
  overflow-y: auto;
  padding: 12px;
  display: grid;
  gap: 10px;
}

.admin-usuario-row {
  padding: 14px;
  border-radius: 18px;
  background: #faf7fb;
  border: 1px solid #f2dce7;
  display: grid;
  gap: 12px;
}

.admin-user-cell p,
.admin-usuario-meta span,
.admin-vacio-texto {
  margin: 4px 0 0;
  color: #706878;
  font-size: 13px;
}

.admin-usuario-meta {
  display: flex;
  justify-content: space-between;
  gap: 10px;
  align-items: center;
}

.admin-mini-acciones,
.admin-empresa-acciones,
.admin-pago-acciones,
.admin-header-botones {
  display: flex;
  gap: 8px;
  flex-wrap: wrap;
}

.admin-mini-acciones.derecha,
.admin-header-botones {
  justify-content: flex-end;
}

.admin-mini-acciones.izquierda {
  justify-content: flex-start;
  margin-top: 12px;
}

.admin-mini-acciones button,
.admin-empresa-acciones button,
.admin-pago-acciones button,
.admin-header-botones button,
.admin-cuenta-card button {
  border: none;
  border-radius: 12px;
  padding: 9px 12px;
  font-size: 12px;
  font-weight: 900;
  cursor: pointer;
}

.admin-mini-acciones .ver,
.admin-empresa-acciones .ver,
.admin-pago-acciones button,
.admin-header-botones button {
  background: #eef2ff;
  color: #3730a3;
}

.admin-mini-acciones .aprobar,
.admin-empresa-acciones .aprobar {
  background: #ecfdf3;
  color: #15803d;
}

.admin-mini-acciones .deshabilitar,
.admin-empresa-acciones .deshabilitar {
  background: #fffbeb;
  color: #b45309;
}

.admin-mini-acciones .eliminar {
  background: #fff1f2;
  color: #be123c;
}

.admin-empresa-acciones .pendiente {
  background: #f2edf1;
  color: #3e3542;
}

.admin-empresa-grupos-lista {
  display: grid;
  gap: 18px;
}

.admin-productos-scroll {
  max-height: 460px;
  overflow-y: auto;
  padding: 16px;
}

.admin-producto-img.grande {
  width: 100%;
  height: 280px;
  border-radius: 22px;
  overflow: hidden;
  background: #fff1f7;
  display: grid;
  place-items: center;
  color: #8f174d;
  font-weight: 900;
}

.admin-producto-img.grande img {
  width: 100%;
  height: 100%;
  object-fit: contain;
}

.admin-empresa-selector-grid {
  display: grid;
  grid-template-columns: repeat(auto-fill, minmax(260px, 1fr));
  gap: 16px;
}

.admin-empresa-selector-card {
  border: 1px solid #eadce5;
  padding: 20px;
  text-align: left;
  cursor: pointer;
  transition: 0.2s ease;
}

.admin-empresa-selector-card:hover {
  transform: translateY(-3px);
  box-shadow: 0 22px 48px rgba(55, 19, 43, 0.12);
  border-color: #f8cfe1;
}

.admin-empresa-selector-card span {
  color: #8f174d;
  font-size: 11px;
  font-weight: 900;
  text-transform: uppercase;
  letter-spacing: 1px;
}

.admin-empresa-selector-card h3 {
  margin: 8px 0;
  color: #1f1724;
  font-size: 22px;
}

.admin-empresa-selector-card p {
  margin: 0 0 12px;
  color: #706878;
}

.admin-empresa-selector-card strong {
  color: #8f174d;
  font-size: 24px;
}

.admin-items-lista.compacta div {
  padding: 11px 12px;
}

.admin-cuenta-grid {
  display: grid;
  grid-template-columns: 1.2fr 1fr 1fr;
  gap: 18px;
}

.admin-cuenta-principal,
.admin-cuenta-card,
.admin-cuenta-form,
.admin-password-form {
  padding: 22px;
}

.admin-cuenta-principal {
  grid-row: span 2;
  display: grid;
  gap: 12px;
  align-content: start;
}

.admin-cuenta-principal .admin-avatar {
  width: 96px;
  height: 96px;
  border-radius: 26px;
  font-size: 34px;
}

.admin-cuenta-principal h3 {
  margin: 0;
  color: #1f1724;
  font-size: 30px;
}

.admin-cuenta-principal p,
.admin-cuenta-card p,
.admin-cuenta-foto-editor p {
  margin: 0;
  color: #706878;
  line-height: 1.55;
}

.admin-cuenta-card strong {
  display: block;
  margin: 9px 0;
  color: #1f1724;
  font-size: 18px;
}

.admin-cuenta-card.seguridad button {
  margin-top: 14px;
  background: #fff1f7;
  color: #8f174d;
}

.admin-cuenta-form {
  display: grid;
  grid-template-columns: 230px 1fr;
  gap: 22px;
}

.admin-cuenta-foto-editor {
  padding: 18px;
  border-radius: 22px;
  background: #fff1f7;
  height: fit-content;
  display: grid;
  gap: 12px;
}

.admin-cuenta-foto-editor .admin-avatar {
  width: 120px;
  height: 120px;
  border-radius: 30px;
  font-size: 42px;
}

.admin-cuenta-foto-editor label {
  color: #8f174d;
  font-weight: 900;
  display: grid;
  gap: 8px;
}

.admin-cuenta-foto-editor input {
  border: 1px solid #eadce5;
  border-radius: 14px;
  padding: 10px;
  background: white;
}

.admin-password-form {
  margin-top: 18px;
  display: grid;
  gap: 16px;
}

.admin-detalle-modal-fondo {
  position: fixed;
  inset: 0;
  z-index: 1600;
  padding: 28px;
  background: rgba(31, 23, 36, 0.68);
  display: grid;
  place-items: center;
  backdrop-filter: blur(10px);
}

.admin-detalle-modal {
  position: relative;
  width: min(820px, 96vw);
  max-height: 90vh;
  overflow-y: auto;
  padding: 24px;
  border-radius: 28px;
  background: white;
  border: 1px solid #eadce5;
  box-shadow: 0 32px 90px rgba(0, 0, 0, 0.28);
}

.admin-detalle-modal h2 {
  margin: 6px 0 18px;
  color: #1f1724;
  font-size: 30px;
}

.admin-modal-cerrar {
  position: absolute;
  top: 14px;
  right: 14px;
  width: 38px;
  height: 38px;
  border: none;
  border-radius: 999px;
  background: #fff1f2;
  color: #be123c;
  font-size: 24px;
  font-weight: 900;
  cursor: pointer;
}

.admin-detalle-layout,
.admin-detalle-producto {
  display: grid;
  grid-template-columns: 130px 1fr;
  gap: 20px;
  align-items: start;
}

.admin-detalle-layout .admin-avatar {
  width: 110px;
  height: 110px;
  border-radius: 30px;
  font-size: 40px;
}

@media (max-width: 1050px) {
  .admin-usuarios-grupos-grid,
  .admin-cuenta-grid,
  .admin-cuenta-form,
  .admin-detalle-layout,
  .admin-detalle-producto {
    grid-template-columns: 1fr;
  }

  .admin-usuarios-scroll,
  .admin-scroll-grid,
  .admin-productos-scroll {
    max-height: none;
  }
}



