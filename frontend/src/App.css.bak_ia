  }

  .pedido-estados {
    justify-content: flex-start;
  }

  .pedido-footer {
    grid-template-columns: 1fr;
  }

  .pedido-item {
    flex-direction: column;
    align-items: flex-start;
  }
}

/* ACCIONES DE PEDIDOS */

.pedido-acciones {
  display: flex;
  gap: 10px;
  flex-wrap: wrap;
  justify-content: flex-end;
  border-top: 1px solid #f2dce7;
  padding-top: 16px;
}

.btn-aprobar-pago,
.btn-rechazar-pago,
.btn-entregar-pedido,
.btn-cancelar-pedido {
  border: none;
  border-radius: 14px;
  padding: 11px 14px;
  font-weight: 900;
  cursor: pointer;
  font-size: 13px;
}

.btn-aprobar-pago {
  background: #ecfdf3;
  color: #15803d;
}

.btn-aprobar-pago:hover {
  background: #dcfce7;
}

.btn-rechazar-pago {
  background: #fff1f2;
  color: #be123c;
}

.btn-rechazar-pago:hover {
  background: #ffe4e6;
}

.btn-entregar-pedido {
  background: #eef2ff;
  color: #3730a3;
}

.btn-entregar-pedido:hover {
  background: #e0e7ff;
}

.btn-cancelar-pedido {
  background: #f2edf1;
  color: #3e3542;
}

.btn-cancelar-pedido:hover {
  background: #e7dde4;
}

.pedido-finalizado {
  padding: 11px 14px;
  border-radius: 14px;
  background: #ecfdf3;
  color: #15803d;
  font-weight: 900;
}

.pedido-cancelado {
  padding: 11px 14px;
  border-radius: 14px;
  background: #fff1f2;
  color: #be123c;
  font-weight: 900;
}

@media (max-width: 850px) {
  .pedido-acciones {
    justify-content: flex-start;
  }
}

/* PAGOS EMPRESA */

.pagos-resumen {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 18px;
  margin-bottom: 20px;
}

.pagos-resumen article {
  background: white;
  border: 1px solid #eadce5;
  border-radius: 22px;
  padding: 20px;
  box-shadow: 0 14px 35px rgba(55, 19, 43, 0.06);
}

.pagos-resumen span {
  color: #8f174d;
  font-size: 12px;
  font-weight: 900;
  text-transform: uppercase;
}

.pagos-resumen strong {
  display: block;
  margin: 10px 0 4px;
  font-size: 30px;
  color: #1f1724;
}

.pagos-resumen p {
  margin: 0;
  color: #706878;
}

.filtros-pagos {
  display: flex;
  gap: 10px;
  flex-wrap: wrap;
  margin-bottom: 18px;
}

.filtros-pagos button {
  border: none;
  border-radius: 999px;
  padding: 10px 14px;
  background: #f2edf1;
  color: #5f5264;
  font-weight: 900;
  cursor: pointer;
}

.filtros-pagos button.activo {
  background: #8f174d;
  color: white;
}

.pagos-lista {
  display: grid;
  gap: 16px;
}

.pago-card {
  background: white;
  border: 1px solid #eadce5;
  border-radius: 24px;
  padding: 22px;
  display: grid;
  gap: 16px;
  box-shadow: 0 14px 35px rgba(55, 19, 43, 0.06);
}

.pago-card-header {
  display: flex;
  justify-content: space-between;
  gap: 16px;
  border-bottom: 1px solid #f2dce7;
  padding-bottom: 14px;
}

.pago-card-header span {
  color: #8f174d;
  font-size: 12px;
  font-weight: 900;
  text-transform: uppercase;
}

.pago-card-header h3 {
  margin: 6px 0;
  color: #1f1724;
}

.pago-card-header p {
  margin: 0;
  color: #706878;
}

.pago-estado {
  height: fit-content;
  padding: 9px 12px;
  border-radius: 999px;
  font-size: 12px;
  font-weight: 900;
  background: #eef2ff;
  color: #3730a3;
}

.pago-estado.PAGADO {
  background: #ecfdf3;
  color: #15803d;
}

.pago-estado.RECHAZADO {
  background: #fff1f2;
  color: #be123c;
}

.pago-estado.EN_REVISION {
  background: #fffbeb;
  color: #b45309;
}

.pago-info-grid {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 14px;
}

.pago-info-grid div {
  background: #fff1f7;
  border-radius: 16px;
  padding: 14px;
}

.pago-info-grid span {
  display: block;
  color: #8f174d;
  font-size: 11px;
  font-weight: 900;
  text-transform: uppercase;
  margin-bottom: 5px;
}

.pago-info-grid strong {
  color: #1f1724;
}

.pago-productos {
  display: grid;
  gap: 8px;
}

.pago-productos div {
  background: #faf7fb;
  border-radius: 16px;
  padding: 12px;
}

.pago-productos strong {
  color: #1f1724;
}

.pago-productos p {
  margin: 5px 0 0;
  color: #706878;
  font-size: 13px;
}

@media (max-width: 850px) {
  .pagos-resumen,
  .pago-info-grid {
    grid-template-columns: 1fr;
  }

  .pago-card-header {
    flex-direction: column;
  }
}

/* INFORMACIÓN EMPRESARIAL */

.info-empresa-grid {
  display: grid;
  grid-template-columns: 1.4fr 1fr 1fr;
  gap: 18px;
}

.info-empresa-principal,
.info-card {
  background: white;
  border: 1px solid #eadce5;
  border-radius: 24px;
  padding: 22px;
  box-shadow: 0 14px 35px rgba(55, 19, 43, 0.06);
}

.info-empresa-principal {
  grid-row: span 2;
  display: flex;
  flex-direction: column;
  justify-content: space-between;
  gap: 22px;
}

.info-empresa-principal span,
.info-card span {
  color: #8f174d;
  font-size: 12px;
  font-weight: 900;
  text-transform: uppercase;
  letter-spacing: 1px;
}

.info-empresa-principal h3 {
  margin: 12px 0;
  font-size: 34px;
  color: #1f1724;
}

.info-empresa-principal p,
.info-card p {
  color: #706878;
  line-height: 1.6;
  margin: 8px 0 0;
}

.info-card strong {
  display: block;
  margin-top: 10px;
  color: #1f1724;
  font-size: 18px;
}

.info-estado-box {
  background: #ecfdf3;
  border-radius: 18px;
  padding: 18px;
}

.info-estado-box strong {
  display: block;
  color: #15803d;
  margin-bottom: 6px;
}

.info-estado-box span {
  color: #15803d;
  font-size: 15px;
}

@media (max-width: 950px) {
  .info-empresa-grid {
    grid-template-columns: 1fr;
  }

  .info-empresa-principal {
    grid-row: auto;
  }
}

/* RESUMEN EMPRESARIAL */

.resumen-grid {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 18px;
  margin-bottom: 22px;
}

.resumen-card {
  background: white;
  border: 1px solid #eadce5;
  border-radius: 24px;
  padding: 22px;
  box-shadow: 0 14px 35px rgba(55, 19, 43, 0.06);
}

.resumen-card.principal {
  background: linear-gradient(135deg, #8f174d, #c22576);
  color: white;
}

.resumen-card span {
  color: #8f174d;
  font-size: 12px;
  font-weight: 900;
  text-transform: uppercase;
  letter-spacing: 1px;
}

.resumen-card.principal span,
.resumen-card.principal p,
.resumen-card.principal strong {
  color: white;
}

.resumen-card strong {
  display: block;
  margin: 10px 0 6px;
  color: #1f1724;
  font-size: 34px;
}

.resumen-card p {
  margin: 0;
  color: #706878;
  line-height: 1.5;
}

.resumen-card.alerta {
  background: #fffbeb;
  border-color: #fde68a;
}

.resumen-card.alerta span,
.resumen-card.alerta strong {
  color: #b45309;
}

.resumen-card.revision {
  background: #eef2ff;
  border-color: #c7d2fe;
}

.resumen-card.revision span,
.resumen-card.revision strong {
  color: #3730a3;
}

.resumen-dos-columnas {
  display: grid;
  grid-template-columns: 1.2fr 1fr;
  gap: 18px;
}

.resumen-panel {
  background: white;
  border: 1px solid #eadce5;
  border-radius: 24px;
  padding: 22px;
  box-shadow: 0 14px 35px rgba(55, 19, 43, 0.06);
}

.resumen-panel-header span {
  color: #8f174d;
  font-size: 12px;
  font-weight: 900;
  text-transform: uppercase;
  letter-spacing: 1px;
}

.resumen-panel-header h3 {
  margin: 7px 0 0;
  color: #1f1724;
  font-size: 22px;
}

.resumen-lista {
  display: grid;
  gap: 10px;
  margin-top: 16px;
}

.resumen-item {
  display: flex;
  justify-content: space-between;
  gap: 14px;
  padding: 14px;
  border-radius: 16px;
  background: #faf7fb;
}

.resumen-item strong {
  color: #1f1724;
}

.resumen-item p {
  margin: 4px 0 0;
  color: #706878;
}

.resumen-item span {
  color: #8f174d;
  font-weight: 900;
}

.resumen-vacio,
.resumen-nota {
  color: #706878;
  line-height: 1.6;
}

.resumen-estado-tienda {
  display: grid;
  gap: 10px;
  margin-top: 16px;
}

.resumen-estado-tienda div {
  padding: 14px;
  border-radius: 16px;
  background: #fff1f7;
}

.resumen-estado-tienda span {
  display: block;
  color: #8f174d;
  font-size: 11px;
  font-weight: 900;
  text-transform: uppercase;
  margin-bottom: 5px;
}

.resumen-estado-tienda strong {
  color: #1f1724;
}

@media (max-width: 950px) {
  .resumen-grid,
  .resumen-dos-columnas {
    grid-template-columns: 1fr;
  }
}

/* ===== TÍTULOS DE CATEGORÍAS ===== */

.categoria-titulo.categoria-bonita {
  display: flex;
  justify-content: space-between;
  align-items: center;
  gap: 14px;
  padding: 16px 20px;
  margin: 18px 0 12px;
  border-radius: 18px;
  background: linear-gradient(135deg, #a81758, #cf2d7b);
  box-shadow: 0 12px 28px rgba(168, 23, 88, 0.18);
  border: none;
}

.categoria-titulo.categoria-bonita h3 {
  margin: 4px 0 0;
  color: #ffffff;
  font-size: 22px;
  font-weight: 900;
  letter-spacing: 0.2px;
}

.categoria-mini-label {
  display: block;
  color: rgba(255, 255, 255, 0.75);
  font-size: 11px;
  font-weight: 900;
  text-transform: uppercase;
  letter-spacing: 1.2px;
}

.categoria-cantidad-pill {
  background: rgba(255, 255, 255, 0.18);
  color: #ffffff;
  border: 1px solid rgba(255, 255, 255, 0.28);
  padding: 8px 14px;
  border-radius: 999px;
  font-size: 13px;
  font-weight: 900;
  white-space: nowrap;
}

@media (max-width: 768px) {
  .categoria-titulo.categoria-bonita {
    flex-direction: column;
    align-items: flex-start;
  }

  .categoria-titulo.categoria-bonita h3 {
    font-size: 20px;
  }
}

/* MI CUENTA EMPRESA */

.cuenta-grid {
  display: grid;
  grid-template-columns: 1.4fr 1fr 1fr;
  gap: 18px;
}

.cuenta-perfil-card,
.cuenta-info-card,
.cuenta-form {
  background: white;
  border: 1px solid #eadce5;
  border-radius: 24px;
  padding: 22px;
  box-shadow: 0 14px 35px rgba(55, 19, 43, 0.06);
}

.cuenta-perfil-card {
  grid-row: span 2;
}

.cuenta-logo-preview {
  width: 96px;
  height: 96px;
  border-radius: 26px;
  background: linear-gradient(135deg, #a81758, #cf2d7b);
  display: grid;
  place-items: center;
  overflow: hidden;
  margin-bottom: 18px;
  color: white;
  font-size: 36px;
  font-weight: 900;
}

.cuenta-logo-preview.grande {
  width: 150px;
  height: 150px;
  border-radius: 34px;
}

.cuenta-logo-preview img {
  width: 100%;
  height: 100%;
  object-fit: cover;
}

.cuenta-perfil-card span,
.cuenta-info-card span,
.cuenta-password-box span {
  color: #8f174d;
  font-size: 12px;
  font-weight: 900;
  text-transform: uppercase;
  letter-spacing: 1px;
}

.cuenta-perfil-card h3 {
  color: #1f1724;
  font-size: 30px;
  margin: 8px 0;
}

.cuenta-perfil-card p,
.cuenta-info-card p,
.cuenta-password-box p {
  color: #706878;
  line-height: 1.6;
}

.cuenta-perfil-card strong {
  display: inline-block;
  margin-top: 12px;
  padding: 8px 12px;
  border-radius: 999px;
  background: #ecfdf3;
  color: #15803d;
}

.cuenta-info-card strong {
  display: block;
  margin-top: 10px;
  color: #1f1724;
  font-size: 18px;
}

.cuenta-edicion-layout {
  display: grid;
  grid-template-columns: 230px 1fr;
  gap: 24px;
}

.cuenta-logo-editor {
  background: #fff1f7;
  border-radius: 22px;
  padding: 20px;
  height: fit-content;
}

.cuenta-logo-editor label {
  display: block;
  color: #8f174d;
  font-weight: 900;
  margin-bottom: 10px;
}

.cuenta-campos {
  display: grid;
  gap: 16px;
}

.cuenta-password-box,
.password-cambio-panel {
  padding: 18px;
  border-radius: 22px;
  background: #faf7fb;
  border: 1px solid #eadce5;
}

.cuenta-password-box {
  display: flex;
  justify-content: space-between;
  gap: 18px;
  align-items: center;
}

.cuenta-password-box h3 {
  margin: 6px 0;
  color: #1f1724;
}

.password-cambio-panel {
  display: grid;
  gap: 16px;
}

@media (max-width: 950px) {
  .cuenta-grid,
  .cuenta-edicion-layout {
    grid-template-columns: 1fr;
  }

  .cuenta-password-box {
    flex-direction: column;
    align-items: flex-start;
  }
} 

/* OJITO PARA CAMBIO DE CONTRASEÑA */

.password-input-panel {
  position: relative;
  display: flex;
  align-items: center;
}

.password-input-panel input {
  width: 100%;
  padding-right: 48px;
}

.btn-ojo-password {
  position: absolute;
  right: 12px;
  top: 50%;
  transform: translateY(-50%);
  width: 34px;
  height: 34px;
  border: none;
  background: transparent;
  color: #706878;
  display: grid;
  place-items: center;
  cursor: pointer;
  border-radius: 999px;
}

.btn-ojo-password:hover {
  background: #fff1f7;
  color: #8f174d;
}

.btn-ojo-password svg {
  width: 20px;
  height: 20px;
}


/* ============================================================
   CATÁLOGO CLIENTE ZYRA
   ============================================================ */

.cliente-catalogo {
  display: grid;
  gap: 22px;
}

.catalogo-hero {
  padding: 34px;
  border-radius: 32px;
  background:
    radial-gradient(circle at 18% 20%, rgba(255, 255, 255, 0.22), transparent 28%),
    linear-gradient(135deg, #8f174d, #c02672 58%, #e879b4);
  color: white;
  display: grid;
  grid-template-columns: 1fr 280px;
  gap: 28px;
  align-items: center;
  box-shadow: 0 26px 65px rgba(143, 23, 77, 0.24);
  overflow: hidden;
  position: relative;
}

.catalogo-hero::after {
  content: "";
  position: absolute;
  width: 220px;
  height: 220px;
  border-radius: 999px;
  background: rgba(255, 255, 255, 0.12);
  right: -80px;
  top: -80px;
}

.catalogo-hero > * {
  position: relative;
  z-index: 1;
}

.catalogo-hero span {
  display: inline-block;
  font-size: 12px;
  font-weight: 900;
  text-transform: uppercase;
  letter-spacing: 1.5px;
  opacity: 0.9;
}

.catalogo-hero h2 {
  margin: 10px 0 12px;
  max-width: 760px;
  font-family: "Playfair Display", serif;
  font-size: clamp(34px, 4vw, 56px);
  line-height: 0.98;
  letter-spacing: -1.2px;
}

.catalogo-hero p {
  margin: 0;
  max-width: 680px;
  line-height: 1.65;
  opacity: 0.92;
  font-size: 15.5px;
}

.catalogo-hero-card {
  min-height: 190px;
  padding: 24px;
  border-radius: 28px;
  background: rgba(255, 255, 255, 0.17);
  border: 1px solid rgba(255, 255, 255, 0.26);
  backdrop-filter: blur(14px);
  display: grid;
  align-content: center;
  text-align: center;
}

.catalogo-hero-card strong {
  display: block;
  color: white;
  font-size: 54px;
  line-height: 1;
}

.catalogo-hero-card span {
  margin-top: 8px;
  color: white;
  opacity: 0.95;
}

.catalogo-hero-card p {
  margin-top: 10px;
  font-size: 13px;
}

.catalogo-buscador-panel {
  background: rgba(255, 255, 255, 0.92);
  border: 1px solid #eadce5;
  border-radius: 28px;
  padding: 22px;
  display: grid;
  gap: 18px;
  box-shadow: 0 16px 42px rgba(55, 19, 43, 0.07);
}

.catalogo-buscador-principal {
  display: grid;
  gap: 10px;
}

.catalogo-buscador-principal label,
.catalogo-filtro label {
  color: #342b39;
  font-size: 13px;
  font-weight: 900;
}

.catalogo-buscador-principal > div {
  display: grid;
  grid-template-columns: 1fr auto;
  gap: 10px;
}

.catalogo-buscador-principal input,
.catalogo-filtro input,
.catalogo-filtro select {
  width: 100%;
  min-height: 50px;
  border: 1px solid #eadce5;
  border-radius: 16px;
  outline: none;
  padding: 0 15px;
  background: white;
  color: #1f1724;
  font-size: 14.5px;
}

.catalogo-buscador-principal input:focus,
.catalogo-filtro input:focus,
.catalogo-filtro select:focus {
  border-color: #8f174d;
  box-shadow: 0 0 0 4px rgba(143, 23, 77, 0.1);
}

.catalogo-buscador-principal button,
.catalogo-filtros-extra button,
.catalogo-vacio button,
.catalogo-btn-detalle,
.catalogo-btn-carrito {
  border: none;
  border-radius: 16px;
  padding: 0 18px;
  min-height: 50px;
  background: linear-gradient(135deg, #8f174d, #c02672);
  color: white;
  font-weight: 900;
  cursor: pointer;
  box-shadow: 0 12px 26px rgba(143, 23, 77, 0.18);
}

.catalogo-filtros-grid {
  display: grid;
  grid-template-columns: repeat(6, 1fr);
  gap: 12px;
}

.catalogo-filtro {
  display: grid;
  gap: 8px;
}

.catalogo-filtros-extra {
  display: flex;
  gap: 10px;
  flex-wrap: wrap;
}

.catalogo-filtros-extra button {
  min-height: 42px;
  background: #f2edf1;
  color: #5f5264;
  box-shadow: none;
}

.catalogo-filtros-extra button.activo {
  background: #fff1f7;
  color: #8f174d;
  border: 1px solid #f8cfe1;
}

.catalogo-grid {
  display: grid;
  grid-template-columns: repeat(auto-fill, minmax(245px, 1fr));
  gap: 20px;
}

.catalogo-producto-card {
  background: white;
  border: 1px solid #eadce5;
  border-radius: 28px;
  overflow: hidden;
  box-shadow: 0 18px 45px rgba(55, 19, 43, 0.08);
  transition: 0.22s ease;
}

.catalogo-producto-card:hover {
  transform: translateY(-4px);
  box-shadow: 0 26px 62px rgba(55, 19, 43, 0.14);
}

.catalogo-imagen {
  width: 100%;
  height: 260px;
  border: none;
  background: #fff1f7;
  padding: 0;
  display: block;
  overflow: hidden;
  position: relative;
  cursor: pointer;
}

.catalogo-imagen img {
  width: 100%;
  height: 100%;
  object-fit: cover;
  transition: 0.3s ease;
}

.catalogo-producto-card:hover .catalogo-imagen img {
  transform: scale(1.04);
}

.catalogo-imagen-placeholder {
  width: 100%;
  height: 100%;
  display: grid;
  place-items: center;
  background:
    radial-gradient(circle at top, rgba(232, 121, 180, 0.35), transparent 34%),
    linear-gradient(135deg, #fff1f7, #f8edf3);
}

.catalogo-imagen-placeholder span {
  width: 82px;
  height: 82px;
  border-radius: 26px;
  background: linear-gradient(135deg, #8f174d, #e879b4);
  color: white;
  display: grid;
  place-items: center;
  font-size: 36px;
  font-weight: 900;
}

.catalogo-ver {
  position: absolute;
  left: 14px;
  bottom: 14px;
  padding: 8px 12px;
  border-radius: 999px;
  background: rgba(31, 23, 36, 0.72);
  color: white;
  font-size: 12px;
  font-weight: 900;
  backdrop-filter: blur(8px);
}

.catalogo-card-info {
  padding: 18px;
}

.catalogo-card-top {
  display: flex;
  justify-content: space-between;
  align-items: center;
  gap: 12px;
}

.catalogo-card-top span {
  color: #8f174d;
  font-size: 11px;
  font-weight: 900;
  text-transform: uppercase;
}

.catalogo-card-top strong {
  color: #1f1724;
  font-size: 18px;
}

.catalogo-card-info h3 {
  margin: 10px 0 5px;
  color: #1f1724;
  font-size: 18px;
  line-height: 1.25;
}

.catalogo-empresa {
  margin: 0;
  color: #8f174d;
  font-weight: 900;
  font-size: 13px;
}

.catalogo-descripcion {
  min-height: 42px;
  margin: 10px 0;
  color: #706878;
  font-size: 13.5px;
  line-height: 1.45;
}

.catalogo-chips {
  display: flex;
  flex-wrap: wrap;
  gap: 7px;
  min-height: 30px;
}

.catalogo-chip {
  display: inline-flex;
  align-items: center;
  gap: 6px;
  padding: 7px 9px;
  border-radius: 999px;
  background: #f8edf3;
  color: #8f174d;
  font-size: 11px;
  font-weight: 900;
}

.catalogo-chip i {
  width: 12px;
  height: 12px;
  border-radius: 999px;
  border: 1px solid #d1d5db;
}

.catalogo-btn-detalle {
  width: 100%;
  margin-top: 14px;
}

.catalogo-vacio,
.cliente-seccion-pendiente {
  background: white;
  border: 1px solid #eadce5;
  border-radius: 28px;
  padding: 28px;
  text-align: center;
  color: #706878;
}

.catalogo-vacio h3,
.cliente-seccion-pendiente h2 {
  margin-top: 0;
  color: #1f1724;
}

/* MODAL PRODUCTO CLIENTE */

.catalogo-modal-fondo {
  position: fixed;
  inset: 0;
  z-index: 1000;
  background: rgba(31, 23, 36, 0.56);
  display: grid;
  place-items: center;
  padding: 28px;
  backdrop-filter: blur(10px);
}

.catalogo-modal {
  width: min(1120px, 100%);
  max-height: min(760px, calc(100vh - 56px));
  overflow-y: auto;
  background: white;
  border-radius: 32px;
  border: 1px solid rgba(255, 255, 255, 0.72);
  box-shadow: 0 32px 90px rgba(0, 0, 0, 0.32);
  position: relative;
}

.catalogo-modal-cargando {
  padding: 40px;
  text-align: center;
  color: #8f174d;
  font-weight: 900;
}

.catalogo-modal-cerrar {
  position: sticky;
  top: 16px;
  float: right;
  margin: 16px 16px 0 0;
  z-index: 2;
  width: 42px;
  height: 42px;
  border: none;
  border-radius: 999px;
  background: #fff1f2;
  color: #be123c;
  font-size: 26px;
  line-height: 1;
  cursor: pointer;
}

.catalogo-detalle-layout {
  clear: both;
  display: grid;
  grid-template-columns: 440px 1fr;
  gap: 28px;
  padding: 26px;
}

.catalogo-detalle-galeria {
  display: grid;
  gap: 12px;
  align-content: start;
}

.catalogo-detalle-imagen-principal {
  height: 560px;
  border: none;
  border-radius: 28px;
  padding: 0;
  background: #fff1f7;
  overflow: hidden;
  position: relative;
  cursor: zoom-in;
}

.catalogo-detalle-imagen-principal img {
  width: 100%;
  height: 100%;
  object-fit: cover;
}

.catalogo-detalle-imagen-principal > span {
  position: absolute;
  left: 16px;
  bottom: 16px;
  padding: 9px 12px;
  border-radius: 999px;
  background: rgba(31, 23, 36, 0.72);
  color: white;
  font-size: 12px;
  font-weight: 900;
}

.catalogo-miniaturas {
  display: flex;
  gap: 10px;
  flex-wrap: wrap;
}

.catalogo-miniaturas button {
  width: 72px;
  height: 72px;
  padding: 0;
  border-radius: 18px;
  border: 2px solid transparent;
  background: #fff1f7;
  overflow: hidden;
  cursor: pointer;
}

.catalogo-miniaturas button.activa {
  border-color: #8f174d;
}

.catalogo-miniaturas img {
  width: 100%;
  height: 100%;
  object-fit: cover;
}

.catalogo-miniaturas span {
  color: #706878;
  font-size: 13px;
}

.catalogo-detalle-info {
  padding: 8px 10px 10px 0;
}

.catalogo-detalle-categoria {
  display: inline-block;
  color: #8f174d;
  font-size: 12px;
  font-weight: 900;
  text-transform: uppercase;
  letter-spacing: 1px;
}

.catalogo-detalle-info h2 {
  margin: 10px 0;
  color: #1f1724;
  font-family: "Playfair Display", serif;
  font-size: clamp(32px, 4vw, 52px);
  line-height: 1;
}

.catalogo-detalle-precio {
  display: flex;
  justify-content: space-between;
  gap: 12px;
  align-items: center;
  padding: 16px;
  border-radius: 20px;
  background: #fff1f7;
  margin: 18px 0;
}

.catalogo-detalle-precio strong {
  color: #8f174d;
  font-size: 30px;
}

.catalogo-detalle-precio span {
  color: #1f1724;
  font-weight: 900;
}

.catalogo-detalle-info p {
  color: #706878;
  line-height: 1.65;
}

.catalogo-detalle-datos {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 12px;
  margin: 20px 0;
}

.catalogo-detalle-datos div {
  padding: 14px;
  border-radius: 18px;
  background: #faf7fb;
}

.catalogo-detalle-datos span {
  display: block;
  color: #8f174d;
  font-size: 11px;
  font-weight: 900;
  text-transform: uppercase;
  margin-bottom: 5px;
}

.catalogo-detalle-datos strong {
  color: #1f1724;
}

.catalogo-variantes-panel h3 {
  margin: 0 0 12px;
  color: #1f1724;
}

.catalogo-variantes-opciones {
  display: grid;
  grid-template-columns: repeat(auto-fill, minmax(130px, 1fr));
  gap: 10px;
}

.catalogo-variantes-opciones button {
  border: 1px solid #eadce5;
  border-radius: 18px;
  background: white;
  padding: 12px;
  display: grid;
  gap: 5px;
  justify-items: start;
  cursor: pointer;
  text-align: left;
}

.catalogo-variantes-opciones button.activa {
  border-color: #8f174d;
  background: #fff1f7;
  box-shadow: 0 0 0 4px rgba(143, 23, 77, 0.08);
}

.catalogo-variantes-opciones button:disabled {
  opacity: 0.48;
  cursor: not-allowed;
}

.catalogo-variantes-opciones i {
  width: 18px;
  height: 18px;
  border-radius: 999px;
  border: 1px solid #d1d5db;
}

.catalogo-variantes-opciones span {
  color: #706878;
  font-size: 12px;
  font-weight: 800;
}

.catalogo-variantes-opciones strong {
  color: #1f1724;
  font-size: 18px;
}

.catalogo-variantes-opciones small {
  color: #8f174d;
  font-weight: 900;
}

.catalogo-detalle-acciones {
  display: flex;
  gap: 12px;
  flex-wrap: wrap;
  margin-top: 22px;
}

.catalogo-btn-carrito {
  min-width: 210px;
}

.catalogo-detalle-acciones a {
  min-height: 50px;
  padding: 0 18px;
  border-radius: 16px;
  background: #ecfdf3;
  color: #15803d;
  font-weight: 900;
  display: inline-grid;
  place-items: center;
  text-decoration: none;
}

.catalogo-lightbox {
  position: fixed;
  inset: 0;
  z-index: 1100;
  background: rgba(0, 0, 0, 0.86);
  display: grid;
  place-items: center;
  padding: 30px;
  cursor: zoom-out;
}

.catalogo-lightbox button {
  position: fixed;
  top: 22px;
  right: 22px;
  width: 48px;
  height: 48px;
  border: none;
  border-radius: 999px;
  background: white;
  color: #1f1724;
  font-size: 30px;
  cursor: pointer;
}

.catalogo-lightbox img {
  max-width: min(1100px, 100%);
  max-height: calc(100vh - 80px);
  object-fit: contain;
  border-radius: 18px;
}

@media (max-width: 1100px) {
  .catalogo-filtros-grid {
    grid-template-columns: repeat(3, 1fr);
  }

  .catalogo-detalle-layout {
    grid-template-columns: 1fr;
  }

  .catalogo-detalle-imagen-principal {
    height: 460px;
  }
}

@media (max-width: 760px) {
  .catalogo-hero {
    grid-template-columns: 1fr;
  }

  .catalogo-buscador-principal > div {
    grid-template-columns: 1fr;
  }

  .catalogo-filtros-grid,
  .catalogo-detalle-datos {
    grid-template-columns: 1fr;
  }

  .catalogo-modal-fondo {
    padding: 12px;
  }

  .catalogo-detalle-layout {
    padding: 18px;
  }

  .catalogo-detalle-imagen-principal {
    height: 360px;
  }

  .catalogo-hero-card {
    min-height: 150px;
  }
}


/* =========================================================
   CLIENTE: INICIO, CATÁLOGO Y BÚSQUEDA POR IMAGEN
   ========================================================= */

.cliente-home,
.cliente-catalogo,
.cliente-ia-page {
  display: grid;
  gap: 24px;
}

.cliente-home-hero,
.cliente-catalogo-hero,
.cliente-ia-hero {
  position: relative;
  overflow: hidden;
  padding: 34px;
  border-radius: 30px;
  background:
    radial-gradient(circle at 92% 10%, rgba(255, 255, 255, 0.22), transparent 28%),
    linear-gradient(135deg, #8f174d, #c02672 58%, #e879b4);
  color: white;
  box-shadow: 0 24px 60px rgba(143, 23, 77, 0.22);
}

.cliente-home-hero,
.cliente-ia-hero {
  display: grid;
  grid-template-columns: 1fr 330px;
  gap: 26px;
  align-items: center;
}

.cliente-home-hero span,
.cliente-catalogo-hero span,
.cliente-ia-hero span,
.cliente-section-title span {
  font-size: 12px;
  font-weight: 900;
  text-transform: uppercase;
  letter-spacing: 1.4px;
}

.cliente-home-hero h2,
.cliente-catalogo-hero h2,
.cliente-ia-hero h2 {
  max-width: 720px;
  margin: 10px 0;
  font-family: "Playfair Display", serif;
  font-size: clamp(34px, 4vw, 54px);
  line-height: 0.98;
}

.cliente-home-hero p,
.cliente-catalogo-hero p,
.cliente-ia-hero p {
  max-width: 680px;
  margin: 0;
  line-height: 1.65;
  opacity: 0.92;
}

.cliente-home-acciones {
  display: flex;
  gap: 12px;
  flex-wrap: wrap;
  margin-top: 24px;
}

.cliente-home-acciones button,
.cliente-section-title button,
.cliente-filtro-busqueda button,
.cliente-filtros-acciones button,
.cliente-btn-carrito,
.cliente-btn-whatsapp {
  border: none;
  border-radius: 15px;
  padding: 13px 18px;
  font-weight: 900;
  cursor: pointer;
  text-decoration: none;
}

.cliente-home-acciones button,
.cliente-filtro-busqueda button,
.cliente-filtros-acciones .principal,
.cliente-btn-carrito {
  background: white;
  color: #8f174d;
}

.cliente-home-acciones button.secundario,
.cliente-section-title button,
.cliente-filtros-acciones button,
.cliente-btn-whatsapp {
  background: #f2edf1;
  color: #3e3542;
}

.cliente-home-panel {
  display: grid;
  gap: 12px;
  padding: 18px;
  border-radius: 26px;
  background: rgba(255, 255, 255, 0.18);
  border: 1px solid rgba(255, 255, 255, 0.25);
  backdrop-filter: blur(8px);
}

.cliente-home-panel div {
  padding: 14px;
  border-radius: 18px;
  background: rgba(255, 255, 255, 0.16);
}

.cliente-home-panel strong {
  display: block;
  font-size: 34px;
  line-height: 1;
}

.cliente-home-panel span {
  font-size: 12px;
  font-weight: 900;
  text-transform: uppercase;
  opacity: 0.86;
}

.cliente-home-section {
  display: grid;
  gap: 16px;
}

.cliente-section-title {
  display: flex;
  justify-content: space-between;
  align-items: center;
  gap: 18px;
  padding: 22px;
  border-radius: 24px;
  background: white;
  border: 1px solid #eadce5;
}

.cliente-section-title span {
  color: #8f174d;
}

.cliente-section-title h3 {
  margin: 7px 0 0;
  font-size: 28px;
  color: #1f1724;
}

.cliente-destacados-grid,
.cliente-productos-grid {
  display: grid;
  grid-template-columns: repeat(auto-fill, minmax(220px, 1fr));
  gap: 18px;
}

.cliente-producto-card {
  overflow: hidden;
  border-radius: 24px;
  background: white;
  border: 1px solid #eadce5;
  box-shadow: 0 16px 38px rgba(55, 19, 43, 0.08);
}

.cliente-producto-card.destacado {
  transform: translateZ(0);
}

.cliente-producto-imagen {
  position: relative;
  width: 100%;
  height: 230px;
  display: grid;
  place-items: center;
  overflow: hidden;
  border: none;
  background: #fff1f7;
  color: #8f174d;
  font-weight: 900;
  cursor: pointer;
}

.cliente-producto-imagen img {
  width: 100%;
  height: 100%;
  object-fit: cover;
  transition: 0.25s ease;
}

.cliente-producto-imagen:hover img {
  transform: scale(1.05);
}

.cliente-card-ver {
  position: absolute;
  left: 12px;
  bottom: 12px;
  padding: 8px 11px;
  border-radius: 999px;
  background: rgba(31, 23, 36, 0.76);
  color: white;
  font-size: 12px;
  font-weight: 900;
}

.cliente-producto-info {
  padding: 16px;
}

.cliente-producto-top {
  display: flex;
  justify-content: space-between;
  gap: 12px;
  align-items: center;
}

.cliente-producto-top span {
  color: #8f174d;
  font-size: 11px;
  font-weight: 900;
  text-transform: uppercase;
}

.cliente-producto-top strong {
  color: #1f1724;
  white-space: nowrap;
}

.cliente-producto-info h3 {
  margin: 8px 0 5px;
  font-size: 18px;
  color: #1f1724;
}

.cliente-producto-info p {
  margin: 0;
  color: #706878;
  font-size: 13px;
}

.cliente-mini-variantes {
  margin-top: 12px;
  display: flex;
  flex-wrap: wrap;
  gap: 6px;
}

.cliente-mini-variantes span {
  display: inline-flex;
  align-items: center;
  gap: 5px;
  padding: 6px 8px;
  border-radius: 999px;
  background: #f8edf3;
  color: #8f174d;
  font-size: 11px;
  font-weight: 900;
}

.cliente-mini-variantes i {
  width: 11px;
  height: 11px;
  border-radius: 999px;
  border: 1px solid #d1d5db;
}

.cliente-tiendas-grid {
  display: grid;
  grid-template-columns: repeat(auto-fill, minmax(230px, 1fr));
  gap: 14px;
}

.cliente-tienda-card {
  display: flex;
  align-items: center;
  gap: 14px;
  padding: 18px;
  border-radius: 22px;
  background: white;
  border: 1px solid #eadce5;
  box-shadow: 0 14px 35px rgba(55, 19, 43, 0.06);
}

.cliente-tienda-logo {
  width: 54px;
  height: 54px;
  flex: 0 0 auto;
  border-radius: 18px;
  display: grid;
  place-items: center;
  background: linear-gradient(135deg, #8f174d, #e879b4);
  color: white;
  font-weight: 900;
  font-size: 24px;
}

.cliente-tienda-card h4 {
  margin: 0;
  color: #1f1724;
}

.cliente-tienda-card p {
  margin: 5px 0 0;
  color: #706878;
  font-size: 13px;
}

.cliente-catalogo-hero {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 22px;
}

.cliente-catalogo-contador {
  min-width: 190px;
  padding: 24px;
  border-radius: 24px;
  background: rgba(255, 255, 255, 0.18);
  text-align: center;
  border: 1px solid rgba(255, 255, 255, 0.25);
}

.cliente-catalogo-contador strong {
  display: block;
  font-size: 42px;
}

.cliente-catalogo-contador span {
  font-size: 12px;
  font-weight: 900;
  text-transform: uppercase;
}

.cliente-filtros-card {
  display: grid;
  gap: 16px;
  padding: 22px;
  border-radius: 26px;
  background: white;
  border: 1px solid #eadce5;
  box-shadow: 0 16px 38px rgba(55, 19, 43, 0.06);
}

.cliente-filtro-busqueda label,
.cliente-filtros-grid label {
  display: grid;
  gap: 8px;
  color: #342b39;
  font-weight: 900;
  font-size: 13px;
}

.cliente-filtro-busqueda div {
  display: grid;
  grid-template-columns: 1fr auto;
  gap: 10px;
}

.cliente-filtro-busqueda input,
.cliente-filtros-grid input,
.cliente-filtros-grid select {
  height: 48px;
  width: 100%;
  border: 1px solid #eadce5;
  border-radius: 14px;
  padding: 0 14px;
  outline: none;
  background: white;
}

.cliente-filtro-busqueda input:focus,
.cliente-filtros-grid input:focus,
.cliente-filtros-grid select:focus {
  border-color: #8f174d;
  box-shadow: 0 0 0 4px rgba(143, 23, 77, 0.1);
}

.cliente-filtros-grid {
  display: grid;
  grid-template-columns: repeat(6, 1fr);
  gap: 12px;
}

.cliente-filtros-acciones {
  display: flex;
  align-items: center;
  gap: 10px;
  flex-wrap: wrap;
}

.cliente-check-stock {
  display: inline-flex;
  align-items: center;
  gap: 8px;
  padding: 11px 14px;
  border-radius: 999px;
  background: #fff1f7;
  color: #8f174d;
  font-size: 13px;
  font-weight: 900;
}

.cliente-vacio,
.cliente-error {
  padding: 24px;
  border-radius: 24px;
  background: white;
  border: 1px solid #eadce5;
  color: #706878;
}

.cliente-vacio h3 {
  margin: 0 0 8px;
  color: #1f1724;
}

.cliente-error {
  background: #fff1f2;
  border-color: #fecdd3;
  color: #be123c;
  font-weight: 900;
}

.cliente-ia-upload {
  padding: 24px;
  border-radius: 26px;
  background: rgba(255, 255, 255, 0.18);
  border: 1px dashed rgba(255, 255, 255, 0.45);
  text-align: center;
}

.cliente-ia-icono {
  width: 78px;
  height: 78px;
  margin: 0 auto 14px;
  border-radius: 24px;
  display: grid;
  place-items: center;
  background: white;
  color: #8f174d;
  font-weight: 900;
  font-size: 28px;
}

.cliente-ia-upload strong {
  display: block;
  font-size: 22px;
}

.cliente-ia-upload button {
  margin-top: 14px;
  border: none;
  border-radius: 14px;
  padding: 12px 16px;
  color: #8f174d;
  font-weight: 900;
}

.cliente-ia-cards {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 18px;
}

.cliente-ia-cards article {
  padding: 22px;
  border-radius: 24px;
  background: white;
  border: 1px solid #eadce5;
  box-shadow: 0 14px 35px rgba(55, 19, 43, 0.06);
}

.cliente-ia-cards span {
  width: 38px;
  height: 38px;
  display: grid;
  place-items: center;
  border-radius: 14px;
  background: #fff1f7;
  color: #8f174d;
  font-weight: 900;
}

.cliente-ia-cards h3 {
  margin: 14px 0 8px;
  color: #1f1724;
}

.cliente-ia-cards p {
  margin: 0;
  color: #706878;
  line-height: 1.6;
}

.cliente-modal-fondo {
  position: fixed;
  inset: 0;
  z-index: 60;
  background: rgba(31, 23, 36, 0.58);
  display: grid;
  place-items: center;
  padding: 26px;
}

.cliente-modal-producto {
  position: relative;
  width: min(1050px, 100%);
  max-height: 90vh;
  overflow-y: auto;
  display: grid;
  grid-template-columns: 430px 1fr;
  gap: 26px;
  padding: 24px;
  border-radius: 30px;
  background: white;
  box-shadow: 0 30px 90px rgba(0, 0, 0, 0.25);
}

.cliente-modal-cerrar {
  position: absolute;
  top: 14px;
  right: 14px;
  z-index: 2;
  width: 38px;
  height: 38px;
  border: none;
  border-radius: 999px;
  background: #f2edf1;
  color: #3e3542;
  font-weight: 900;
  font-size: 22px;
  cursor: pointer;
}

.cliente-detalle-galeria {
  display: grid;
  gap: 12px;
}

.cliente-detalle-img-principal {
  height: 520px;
  border: none;
  border-radius: 26px;
  background: #fff1f7;
  overflow: hidden;
  display: grid;
  place-items: center;
  color: #8f174d;
  font-weight: 900;
  cursor: zoom-in;
}

.cliente-detalle-img-principal img,
.cliente-miniaturas img,
.cliente-lightbox img {
  width: 100%;
  height: 100%;
  object-fit: cover;
}

.cliente-miniaturas {
  display: flex;
  gap: 10px;
  overflow-x: auto;
}

.cliente-miniaturas button {
  width: 72px;
  height: 72px;
  flex: 0 0 auto;
  border: none;
  border-radius: 16px;
  overflow: hidden;
  background: #fff1f7;
  cursor: pointer;
}

.cliente-detalle-info {
  padding-right: 34px;
}

.cliente-detalle-info > span {
  color: #8f174d;
  font-size: 12px;
  font-weight: 900;
  text-transform: uppercase;
  letter-spacing: 1.2px;
}

.cliente-detalle-info h2 {
  margin: 9px 0 12px;
  color: #1f1724;
  font-size: 36px;
  line-height: 1.05;
}

.cliente-detalle-info p {
  color: #706878;
  line-height: 1.65;
}

.cliente-detalle-precio {
  display: flex;
  justify-content: space-between;
  gap: 14px;
  align-items: center;
  padding: 16px;
  border-radius: 18px;
  background: #fff1f7;
  margin: 18px 0;
}

.cliente-detalle-precio strong {
  color: #8f174d;
  font-size: 28px;
}

.cliente-detalle-precio p {
  margin: 0;
  font-weight: 900;
}

.cliente-detalle-datos {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 12px;
}

.cliente-detalle-datos div {
  padding: 14px;
  border-radius: 16px;
  background: #faf7fb;
}

.cliente-detalle-datos span {
  display: block;
  color: #8f174d;
  font-size: 11px;
  font-weight: 900;
  text-transform: uppercase;
  margin-bottom: 5px;
}

.cliente-variantes-selector {
  margin-top: 20px;
}

.cliente-variantes-selector h3 {
  margin: 0 0 12px;
}

.cliente-variantes-lista {
  display: grid;
  gap: 10px;
}

.cliente-variantes-lista button {
  display: grid;
  grid-template-columns: 18px 1fr auto;
  align-items: center;
  gap: 10px;
  padding: 13px;
  border: 1px solid #eadce5;
  border-radius: 16px;
  background: white;
  cursor: pointer;
  text-align: left;
}

.cliente-variantes-lista button.activo {
  border-color: #8f174d;
  box-shadow: 0 0 0 4px rgba(143, 23, 77, 0.1);
}

.cliente-variantes-lista button:disabled {
  opacity: 0.45;
  cursor: not-allowed;
}

.cliente-variantes-lista i {
  width: 16px;
  height: 16px;
  border-radius: 999px;
  border: 1px solid #d1d5db;
}

.cliente-variantes-lista span {
  font-weight: 900;
  color: #1f1724;
}

.cliente-variantes-lista small {
  color: #706878;
  font-weight: 800;
}

.cliente-detalle-acciones {
  display: flex;
  gap: 12px;
  flex-wrap: wrap;
  margin-top: 22px;
}

.cliente-btn-carrito {
  background: linear-gradient(135deg, #8f174d, #c02672);
  color: white;
}

.cliente-btn-carrito:disabled {
  opacity: 0.6;
  cursor: not-allowed;
}

.cliente-btn-whatsapp {
  display: inline-grid;
  place-items: center;
}

.cliente-lightbox {
  position: fixed;
  inset: 0;
  z-index: 80;
  display: grid;
  place-items: center;
  background: rgba(15, 12, 18, 0.84);
  padding: 30px;
}

.cliente-lightbox button {
  position: fixed;
  top: 20px;
  right: 24px;
  width: 44px;
  height: 44px;
  border: none;
  border-radius: 999px;
  background: white;
  color: #1f1724;
  font-weight: 900;
  font-size: 24px;
  cursor: pointer;
}

.cliente-lightbox img {
  width: auto;
  max-width: 92vw;
  height: auto;
  max-height: 86vh;
  border-radius: 24px;
  object-fit: contain;
}

@media (max-width: 1050px) {
  .cliente-filtros-grid {
    grid-template-columns: repeat(3, 1fr);
  }

  .cliente-modal-producto {
    grid-template-columns: 1fr;
  }

  .cliente-detalle-info {
    padding-right: 0;
  }

  .cliente-detalle-img-principal {
    height: 420px;
  }
}

@media (max-width: 850px) {
  .cliente-home-hero,
  .cliente-catalogo-hero,
  .cliente-ia-hero {
    grid-template-columns: 1fr;
  }

  .cliente-catalogo-hero,
  .cliente-section-title {
    flex-direction: column;
    align-items: flex-start;
  }

  .cliente-filtro-busqueda div,
  .cliente-filtros-grid,
  .cliente-ia-cards,
  .cliente-detalle-datos {
    grid-template-columns: 1fr;
  }
}

/* ===== CARRITO CLIENTE ===== */

.cliente-page-con-carrito {
  position: relative;
}

.cliente-cart-top {
  position: sticky;
  top: 0;
  margin-left: auto;
  margin-bottom: 14px;
  z-index: 20;
  width: 54px;
  height: 54px;
  border: none;
  border-radius: 18px;
  background: rgba(255, 255, 255, 0.94);
  color: #8f174d;
  display: grid;
  place-items: center;
  cursor: pointer;
  box-shadow: 0 14px 35px rgba(55, 19, 43, 0.12);
  border: 1px solid #eadce5;
}

.cliente-cart-top svg {
  width: 24px;
  height: 24px;
}

.cliente-cart-top span {
  position: absolute;
  top: -7px;
  right: -7px;
  min-width: 24px;
  height: 24px;
  padding: 0 7px;
  border-radius: 999px;
  background: linear-gradient(135deg, #8f174d, #c02672);
  color: white;
  display: grid;
  place-items: center;
  font-size: 12px;
  font-weight: 900;
  box-shadow: 0 8px 18px rgba(143, 23, 77, 0.28);
}

.cliente-cart-top:hover {
  transform: translateY(-1px);
  color: #5f0f33;
}

.cliente-card-carrito {
  width: 100%;
  margin-top: 14px;
  border: none;
  border-radius: 14px;
  padding: 12px 14px;
  background: #fff1f7;
  color: #8f174d;
  font-weight: 900;
  cursor: pointer;
}

.cliente-card-carrito:hover {
  background: #fce7f3;
}

.cliente-detalle-cantidad {
  margin: 18px 0;
  padding: 16px;
  border-radius: 18px;
  background: #faf7fb;
  border: 1px solid #eadce5;
  display: flex;
  justify-content: space-between;
  align-items: center;
  gap: 14px;
}

.cliente-detalle-cantidad span {
  color: #8f174d;
  font-size: 12px;
  font-weight: 900;
  text-transform: uppercase;
}

.cliente-detalle-cantidad div,
.cliente-carrito-cantidad {
  display: flex;
  align-items: center;
  gap: 8px;
}

.cliente-detalle-cantidad button,
.cliente-carrito-cantidad button {
  width: 38px;
  height: 38px;
  border: none;
  border-radius: 12px;
  background: #fff1f7;
  color: #8f174d;
  font-size: 18px;
  font-weight: 900;
  cursor: pointer;
}

.cliente-detalle-cantidad input,
.cliente-carrito-cantidad input {
  width: 56px;
  height: 38px;
  border: 1px solid #eadce5;
  border-radius: 12px;
  text-align: center;
  font-weight: 900;
  color: #1f1724;
  outline: none;
}

.cliente-carrito-page {
  display: grid;
  gap: 20px;
}

.cliente-carrito-header {
  padding: 28px;
  border-radius: 28px;
  background: linear-gradient(135deg, #8f174d, #c02672);
  color: white;
  display: flex;
  justify-content: space-between;
  align-items: center;
  gap: 20px;
  box-shadow: 0 24px 60px rgba(143, 23, 77, 0.2);
}

.cliente-carrito-header span {
  font-size: 12px;
  font-weight: 900;
  text-transform: uppercase;
  letter-spacing: 1.4px;
}

.cliente-carrito-header h2 {
  margin: 8px 0;
  font-size: 34px;
}

.cliente-carrito-header p {
  margin: 0;
  max-width: 620px;
  line-height: 1.6;
  opacity: 0.9;
}

.cliente-carrito-header button {
  border: none;
  padding: 13px 18px;
  border-radius: 15px;
  background: white;
  color: #8f174d;
  font-weight: 900;
  cursor: pointer;
}

.cliente-mensaje-carrito {
  padding: 14px 16px;
  border-radius: 16px;
  background: #ecfdf3;
  color: #15803d;
  border: 1px solid #bbf7d0;
  font-weight: 900;
}

.cliente-carrito-vacio {
  min-height: 360px;
  border: 1px solid #eadce5;
  border-radius: 28px;
  background: white;
  display: grid;
  place-items: center;
  text-align: center;
  padding: 40px;
  box-shadow: 0 16px 38px rgba(55, 19, 43, 0.08);
}

.cliente-carrito-vacio-icon {
  width: 86px;
  height: 86px;
  border-radius: 28px;
  background: #fff1f7;
  color: #8f174d;
  display: grid;
  place-items: center;
  margin-bottom: 10px;
}

.cliente-carrito-vacio-icon svg {
  width: 42px;
  height: 42px;
}

.cliente-carrito-vacio h3 {
  margin: 0;
  color: #1f1724;
  font-size: 28px;
}

.cliente-carrito-vacio p {
  color: #706878;
  margin: 8px 0 18px;
}

.cliente-carrito-vacio button {
  border: none;
  border-radius: 15px;
  padding: 14px 20px;
  background: linear-gradient(135deg, #8f174d, #c02672);
  color: white;
  font-weight: 900;
  cursor: pointer;
}

.cliente-carrito-layout {
  display: grid;
  grid-template-columns: 1fr 330px;
  gap: 22px;
  align-items: start;
}

.cliente-carrito-items {
  display: grid;
  gap: 14px;
}

.cliente-carrito-item {
  background: white;
  border: 1px solid #eadce5;
  border-radius: 24px;
  padding: 16px;
  display: grid;
  grid-template-columns: 120px 1fr auto 150px;
  gap: 16px;
  align-items: center;
  box-shadow: 0 14px 35px rgba(55, 19, 43, 0.06);
}

.cliente-carrito-img {
  width: 120px;
  height: 130px;
  border-radius: 18px;
  overflow: hidden;
  background: #fff1f7;
  display: grid;
  place-items: center;
  color: #8f174d;
  font-weight: 900;
}

.cliente-carrito-img img {
  width: 100%;
  height: 100%;
  object-fit: cover;
}

.cliente-carrito-info span {
  color: #8f174d;
  font-size: 12px;
  font-weight: 900;
  text-transform: uppercase;
}

.cliente-carrito-info h3 {
  margin: 6px 0;
  color: #1f1724;
  font-size: 20px;
}

.cliente-carrito-info p {
  margin: 0 0 10px;
  color: #706878;
}

.cliente-carrito-info strong {
  color: #8f174d;
  font-size: 18px;
}

.cliente-carrito-subtotal {
  display: grid;
  gap: 6px;
  justify-items: end;
}

.cliente-carrito-subtotal span {
  color: #706878;
  font-size: 12px;
  font-weight: 900;
  text-transform: uppercase;
}

.cliente-carrito-subtotal strong {
  color: #1f1724;
  font-size: 20px;
}

.cliente-carrito-subtotal button {
  border: none;
  border-radius: 12px;
  padding: 9px 12px;
  background: #fff1f2;
  color: #be123c;
  font-weight: 900;
  cursor: pointer;
}

.cliente-carrito-resumen {
  position: sticky;
  top: 20px;
  background: white;
  border: 1px solid #eadce5;
  border-radius: 26px;
  padding: 22px;
  box-shadow: 0 18px 45px rgba(55, 19, 43, 0.1);
}

.cliente-carrito-resumen > span {
  color: #8f174d;
  font-size: 12px;
  font-weight: 900;
  text-transform: uppercase;
  letter-spacing: 1px;
}

.cliente-carrito-resumen h3 {
  margin: 8px 0 18px;
  font-size: 24px;
  color: #1f1724;
}

.cliente-carrito-resumen div {
  padding: 18px;
  border-radius: 18px;
  background: #fff1f7;
  margin-bottom: 16px;
}

.cliente-carrito-resumen p {
  margin: 0 0 6px;
  color: #8f174d;
  font-weight: 900;
  text-transform: uppercase;
  font-size: 12px;
}

.cliente-carrito-resumen strong {
  font-size: 30px;
  color: #1f1724;
}

.cliente-carrito-finalizar,
.cliente-carrito-seguir {
  width: 100%;
  border: none;
  border-radius: 15px;
  padding: 14px 16px;
  font-weight: 900;
  cursor: pointer;
  margin-top: 10px;
}

.cliente-carrito-finalizar {
  background: linear-gradient(135deg, #8f174d, #c02672);
  color: white;
}

.cliente-carrito-seguir {
  background: #f2edf1;
  color: #3e3542;
}

@media (max-width: 1050px) {
  .cliente-carrito-layout,
  .cliente-carrito-item {
    grid-template-columns: 1fr;
  }

  .cliente-carrito-img {
    width: 100%;
    height: 220px;
  }

  .cliente-carrito-subtotal {
    justify-items: start;
  }

  .cliente-carrito-header {
    flex-direction: column;
    align-items: flex-start;
  }
}

/* ===== AJUSTES CLIENTE: CARRITO SIN REDIRECCIÓN Y MENÚ ===== */

.portal-sidebar-footer {
  margin-top: auto;
  display: grid;
  gap: 10px;
}

.portal-sidebar-footer .portal-volver,
.portal-cerrar-sesion {
  width: 100%;
  border: none;
  border-radius: 15px;
  padding: 13px;
  font-weight: 900;
  cursor: pointer;
  text-align: center;
}

.portal-sidebar-footer .portal-volver {
  margin-top: 0;
  background: #f2edf1;
  color: #3e3542;
}

.portal-cerrar-sesion {
  background: #fff1f2;
  color: #be123c;
}

.portal-cerrar-sesion:hover {
  background: #ffe4e6;
}

.portal-sidebar-footer .portal-volver:hover {
  background: #e8dde5;
}

.cliente-page-con-carrito {
  position: relative;
}

.cliente-cart-top {
  position: fixed;
  top: 76px;
  right: 34px;
  z-index: 80;
  width: 54px;
  height: 54px;
  border: none;
  border-radius: 18px;
  background: rgba(255, 255, 255, 0.96);
  color: #8f174d;
  display: grid;
  place-items: center;
  cursor: pointer;
  box-shadow: 0 14px 35px rgba(55, 19, 43, 0.14);
  border: 1px solid #eadce5;
  transition: 0.2s ease;
}

.cliente-cart-top svg {
  width: 24px;
  height: 24px;
}

.cliente-cart-top span {
  position: absolute;
  top: -7px;
  right: -7px;
  min-width: 24px;
  height: 24px;
  padding: 0 7px;
  border-radius: 999px;
  background: linear-gradient(135deg, #8f174d, #c02672);
  color: white;
  display: grid;
  place-items: center;
  font-size: 12px;
  font-weight: 900;
  box-shadow: 0 8px 18px rgba(143, 23, 77, 0.28);
}

.cliente-cart-top:hover {
  transform: translateY(-2px);
  color: #5f0f33;
}

.cliente-toast {
  position: fixed;
  top: 30px;
  right: 34px;
  z-index: 200;
  max-width: 360px;
  padding: 15px 18px;
  border-radius: 18px;
  background: rgba(255, 255, 255, 0.96);
  color: #15803d;
  border: 1px solid #bbf7d0;
  box-shadow: 0 18px 45px rgba(55, 19, 43, 0.16);
  animation: clienteToastEntrada 0.25s ease;
}

.cliente-toast strong {
  display: block;
  font-size: 14px;
  line-height: 1.35;
}

.cliente-toast.ok {
  background: #ecfdf3;
  color: #15803d;
}

@keyframes clienteToastEntrada {
  from {
    opacity: 0;
    transform: translateY(-10px);
  }
  to {
    opacity: 1;
    transform: translateY(0);
  }
}

@media (max-width: 960px) {
  .cliente-cart-top {
    top: 22px;
    right: 22px;
  }

  .cliente-toast {
    top: 86px;
    right: 18px;
    left: 18px;
    max-width: none;
  }
}

/* ===== QR DE PAGO Y COMPROBANTES EMPRESA ===== */

.qr-pago-card {
  display: grid;
  grid-template-columns: 1fr 260px;
  gap: 20px;
  align-items: stretch;
  background: white;
  border: 1px solid #eadce5;
  border-radius: 26px;
  padding: 22px;
  box-shadow: 0 14px 35px rgba(55, 19, 43, 0.06);
}

.qr-pago-info span,
.pago-comprobante-box span {
  color: #8f174d;
  font-size: 12px;
  font-weight: 900;
  text-transform: uppercase;
  letter-spacing: 1px;
}

.qr-pago-info h3 {
  margin: 8px 0;
  color: #1f1724;
  font-size: 24px;
}

.qr-pago-info p {
  margin: 0 0 14px;
  color: #706878;
  line-height: 1.6;
}

.qr-pago-acciones {
  display: flex;
  gap: 10px;
  flex-wrap: wrap;
  align-items: center;
}

.qr-upload-label {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  min-height: 46px;
  padding: 12px 16px;
  border-radius: 15px;
  background: #fff1f7;
  color: #8f174d;
  font-weight: 900;
  cursor: pointer;
  border: 1px dashed #f0b7d3;
}

.qr-upload-label input {
  display: none;
}

.qr-archivo-seleccionado {
  margin-top: 12px !important;
  font-size: 13px;
}

.qr-pago-preview {
  min-height: 230px;
  border-radius: 22px;
  background: #fff1f7;
  border: 1px dashed #f0b7d3;
  display: grid;
  place-items: center;
  overflow: hidden;
  text-align: center;
  color: #8f174d;
}

.qr-pago-preview button {
  width: 100%;
  height: 100%;
  min-height: 230px;
  border: none;
  background: transparent;
  padding: 0;
  cursor: zoom-in;
}

.qr-pago-preview img {
  width: 100%;
  height: 100%;
  object-fit: contain;
  padding: 12px;
}

.qr-pago-preview strong {
  display: block;
  color: #8f174d;
  font-size: 20px;
}

.qr-pago-preview p {
  max-width: 190px;
  margin: 8px auto 0;
  color: #706878;
  line-height: 1.5;
}

.pago-comprobante-box {
  display: flex;
  justify-content: space-between;
  gap: 14px;
  align-items: center;
  padding: 16px;
  border-radius: 18px;
  background: #faf7fb;
  border: 1px solid #eadce5;
}

.pago-comprobante-box strong {
  display: block;
  margin: 6px 0;
  color: #1f1724;
}

.pago-comprobante-box p {
  margin: 0;
  color: #706878;
  line-height: 1.5;
}

.pago-comprobante-box button {
  border: none;
  border-radius: 14px;
  padding: 12px 15px;
  background: #eef2ff;
  color: #3730a3;
  font-weight: 900;
  cursor: pointer;
  white-space: nowrap;
}

.pago-comprobante-box button:hover {
  background: #e0e7ff;
}

.comprobante-modal-fondo {
  position: fixed;
  inset: 0;
  z-index: 1500;
  display: grid;
  place-items: center;
  padding: 28px;
  background: rgba(31, 23, 36, 0.72);
  backdrop-filter: blur(10px);
}

.comprobante-modal {
  position: relative;
  width: min(760px, 96vw);
  max-height: 92vh;
  padding: 20px;
  border-radius: 28px;
  background: white;
  box-shadow: 0 30px 90px rgba(0, 0, 0, 0.32);
}

.comprobante-modal img {
  display: block;
  width: 100%;
  max-height: calc(92vh - 40px);
  object-fit: contain;
  border-radius: 20px;
  background: #fff1f7;
}

.comprobante-modal-cerrar {
  position: absolute;
  top: -14px;
  right: -14px;
  width: 44px;
  height: 44px;
  border: none;
  border-radius: 999px;
  background: #fff1f2;
  color: #be123c;
  font-size: 28px;
  font-weight: 900;
  cursor: pointer;
  box-shadow: 0 12px 28px rgba(55, 19, 43, 0.16);
}

@media (max-width: 850px) {
  .qr-pago-card {
    grid-template-columns: 1fr;
  }

  .pago-comprobante-box {
    flex-direction: column;
    align-items: flex-start;
  }
}

/* ===== CLIENTE: PAGO CON QR Y COMPROBANTE ===== */

.cliente-pago-page,
.cliente-pedidos-page {
  display: grid;
  gap: 20px;
}

.cliente-pago-hero {
  padding: 30px;
  border-radius: 28px;
  background: linear-gradient(135deg, #8f174d, #c02672 58%, #e879b4);
  color: white;
  display: grid;
  grid-template-columns: 1fr 300px;
  gap: 22px;
  align-items: center;
  box-shadow: 0 24px 60px rgba(143, 23, 77, 0.2);
}

.cliente-pago-hero span,
.cliente-pago-qr-card > span,
.cliente-pago-form-card > span {
  font-size: 12px;
  font-weight: 900;
  text-transform: uppercase;
  letter-spacing: 1.3px;
}

.cliente-pago-hero h2 {
  margin: 8px 0;
  font-size: 36px;
  line-height: 1.05;
}

.cliente-pago-hero p {
  margin: 0;
  line-height: 1.6;
  opacity: 0.92;
}

.cliente-pago-total {
  padding: 22px;
  border-radius: 24px;
  background: rgba(255, 255, 255, 0.18);
  border: 1px solid rgba(255, 255, 255, 0.26);
  backdrop-filter: blur(8px);
}

.cliente-pago-total strong {
  display: block;
  margin: 8px 0;
  color: white;
  font-size: 36px;
}

.cliente-pago-layout {
  display: grid;
  grid-template-columns: 360px 1fr;
  gap: 20px;
  align-items: start;
}

.cliente-pago-qr-card,
.cliente-pago-form-card,
.cliente-pedido-card {
  background: white;
  border: 1px solid #eadce5;
  border-radius: 26px;
  padding: 22px;
  box-shadow: 0 16px 38px rgba(55, 19, 43, 0.08);
}

.cliente-pago-qr-card > span,
.cliente-pago-form-card > span {
  color: #8f174d;
}

.cliente-pago-qr-card h3,
.cliente-pago-form-card h3 {
  margin: 8px 0 12px;
  color: #1f1724;
  font-size: 24px;
}

.cliente-pago-form-card p {
  color: #706878;
  line-height: 1.6;
}

.cliente-pago-qr-img {
  width: 100%;
  border: 1px dashed #f3bdd6;
  border-radius: 24px;
  padding: 12px;
  background: #fff1f7;
  cursor: zoom-in;
  display: grid;
  gap: 10px;
}

.cliente-pago-qr-img img {
  width: 100%;
  max-height: 360px;
  object-fit: contain;
  border-radius: 18px;
  background: white;
}

.cliente-pago-qr-img small {
  color: #8f174d;
  font-weight: 900;
}

.cliente-pago-sin-qr,
.cliente-pago-alerta {
  padding: 16px;
  border-radius: 18px;
  background: #fffbeb;
  color: #b45309;
  border: 1px solid #fde68a;
  font-weight: 900;
  line-height: 1.5;
}

.cliente-pago-datos-tienda {
  display: grid;
  gap: 12px;
  margin-top: 14px;
}

.cliente-pago-datos-tienda div {
  padding: 15px;
  border-radius: 18px;
  background: #faf7fb;
}

.cliente-pago-datos-tienda span {
  display: block;
  color: #8f174d;
  font-size: 11px;
  font-weight: 900;
  text-transform: uppercase;
  margin-bottom: 5px;
}

.cliente-pago-datos-tienda strong {
  color: #1f1724;
  font-size: 24px;
}

.cliente-pago-datos-tienda a {
  text-align: center;
  text-decoration: none;
  padding: 13px 16px;
  border-radius: 15px;
  background: #ecfdf3;
  color: #15803d;
  font-weight: 900;
}

.cliente-pago-estado {
  margin: 12px 0;
  padding: 13px 15px;
  border-radius: 16px;
  background: #eef2ff;
  color: #3730a3;
  font-weight: 900;
}

.cliente-pago-estado.PAGADO {
  background: #ecfdf3;
  color: #15803d;
}

.cliente-pago-estado.RECHAZADO {
  background: #fff1f2;
  color: #be123c;
}

.cliente-pago-file {
  display: grid;
  gap: 8px;
  margin: 16px 0;
  color: #342b39;
  font-weight: 900;
}

.cliente-pago-file input {
  min-height: 52px;
  border: 1px solid #eadce5;
  border-radius: 16px;
  padding: 13px;
  background: white;
}

.cliente-pago-preview {
  margin: 12px 0;
  padding: 12px;
  border-radius: 20px;
  background: #faf7fb;
  border: 1px solid #eadce5;
}

.cliente-pago-preview img {
  width: 100%;
  max-height: 280px;
  object-fit: contain;
  border-radius: 16px;
  background: white;
}

.cliente-pago-preview p {
  margin: 8px 0 0;
  color: #706878;
  font-weight: 800;
}

.cliente-pedidos-lista {
  display: grid;
  gap: 16px;
}

.cliente-pedido-card {
  display: grid;
  gap: 14px;
}

.cliente-pedido-header {
  display: flex;
  justify-content: space-between;
  gap: 18px;
  align-items: flex-start;
  border-bottom: 1px solid #f2dce7;
  padding-bottom: 14px;
}

.cliente-pedido-header span {
  color: #8f174d;
  font-size: 12px;
  font-weight: 900;
  text-transform: uppercase;
  letter-spacing: 1px;
}

.cliente-pedido-header h3 {
  margin: 6px 0;
  color: #1f1724;
  font-size: 28px;
}

.cliente-pedido-header p {
  margin: 0;
  color: #706878;
}

.cliente-pedido-badges {
  display: flex;
  gap: 8px;
  flex-wrap: wrap;
  justify-content: flex-end;
}

.cliente-pedido-badges strong {
  padding: 9px 12px;
  border-radius: 999px;
  background: #fff1f7;
  color: #8f174d;
  font-size: 12px;
}

.cliente-ver-comprobante {
  width: fit-content;
  border: none;
  border-radius: 14px;
  padding: 12px 15px;
  background: #eef2ff;
  color: #3730a3;
  font-weight: 900;
  cursor: pointer;
}

@media (max-width: 950px) {
  .cliente-pago-hero,
  .cliente-pago-layout {
    grid-template-columns: 1fr;
  }

  .cliente-pedido-header {
    flex-direction: column;
  }

  .cliente-pedido-badges {
    justify-content: flex-start;
  }
}

/* =========================================================
   CLIENTE: EMPRESAS CLICABLES Y PEDIDOS CON AVISOS
   ========================================================= */

.cliente-producto-empresa-btn,
.cliente-detalle-empresa-btn,
.cliente-pedido-tienda-btn {
  border: none;
  background: transparent;
  padding: 0;
  display: inline-flex;
  align-items: center;
  gap: 9px;
  color: #8f174d;
  font-weight: 900;
  cursor: pointer;
  text-align: left;
}

.cliente-producto-empresa-btn {
  margin-top: 6px;
}

.cliente-producto-empresa-btn:hover,
.cliente-detalle-empresa-btn:hover,
.cliente-pedido-tienda-btn:hover {
  color: #5f0f33;
  text-decoration: underline;
}

.cliente-empresa-mini-logo {
  width: 34px;
  height: 34px;
  flex: 0 0 auto;
  border-radius: 12px;
  display: grid;
  place-items: center;
  overflow: hidden;
  background: linear-gradient(135deg, #8f174d, #e879b4);
  color: white;
  font-size: 15px;
  font-weight: 900;
  text-decoration: none;
}

.cliente-empresa-mini-logo img,
.cliente-empresa-logo-modal img {
  width: 100%;
  height: 100%;
  object-fit: cover;
}

.cliente-tienda-card.clickable {
  width: 100%;
  border: 1px solid #eadce5;
  cursor: pointer;
  text-align: left;
  transition: 0.2s ease;
}

.cliente-tienda-card.clickable:hover {
  transform: translateY(-2px);
  box-shadow: 0 20px 45px rgba(55, 19, 43, 0.11);
  border-color: #f8cfe1;
}

.cliente-tienda-card small {
  display: inline-block;
  margin-top: 6px;
  color: #8f174d;
  font-weight: 900;
}

.cliente-detalle-empresa-btn {
  padding: 8px 10px;
  border-radius: 16px;
  background: white;
  text-decoration: none;
}

.cliente-empresa-modal {
  position: relative;
  width: min(780px, 100%);
  max-height: 90vh;
  overflow-y: auto;
  padding: 26px;
  border-radius: 30px;
  background: white;
  border: 1px solid #eadce5;
  box-shadow: 0 30px 90px rgba(0, 0, 0, 0.25);
}

.cliente-empresa-modal-header {
  display: grid;
  grid-template-columns: 120px 1fr;
  gap: 20px;
  align-items: center;
  padding-bottom: 20px;
  border-bottom: 1px solid #f2dce7;
}

.cliente-empresa-logo-modal {
  width: 110px;
  height: 110px;
  border-radius: 30px;
  display: grid;
  place-items: center;
  overflow: hidden;
  background: linear-gradient(135deg, #8f174d, #e879b4);
  color: white;
  font-size: 44px;
  font-weight: 900;
}

.cliente-empresa-modal-header span {
  color: #8f174d;
  font-size: 12px;
  font-weight: 900;
  text-transform: uppercase;
  letter-spacing: 1px;
}

.cliente-empresa-modal-header h2 {
  margin: 8px 0;
  color: #1f1724;
  font-size: 34px;
}

.cliente-empresa-modal-header p {
  margin: 0;
  color: #706878;
  line-height: 1.6;
}

.cliente-empresa-info-grid {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 14px;
  margin-top: 18px;
}

.cliente-empresa-info-grid div {
  padding: 16px;
  border-radius: 18px;
  background: #fff1f7;
}

.cliente-empresa-info-grid span {
  display: block;
  margin-bottom: 6px;
  color: #8f174d;
  font-size: 11px;
  font-weight: 900;
  text-transform: uppercase;
}

.cliente-empresa-info-grid strong {
  display: block;
  color: #1f1724;
}

.cliente-empresa-info-grid p {
  margin: 6px 0 0;
  color: #706878;
}

.cliente-empresa-modal-actions {
  display: flex;
  flex-wrap: wrap;
  gap: 12px;
  justify-content: flex-end;
  margin-top: 20px;
}

.cliente-pedido-card.detalle {
  display: grid;
  gap: 16px;
}

.cliente-pedido-notificaciones {
  display: grid;
  gap: 12px;
}

.cliente-pedido-aviso {
  padding: 16px;
  border-radius: 20px;
  border: 1px solid #eadce5;
  background: #faf7fb;
}

.cliente-pedido-aviso.PAGADO {
  background: #ecfdf3;
  border-color: #bbf7d0;
}

.cliente-pedido-aviso.EN_REVISION {
  background: #fffbeb;
  border-color: #fde68a;
}

.cliente-pedido-aviso.RECHAZADO,
.cliente-pedido-aviso.CANCELADO {
  background: #fff1f2;
  border-color: #fecdd3;
}

.cliente-pedido-aviso-header {
  display: flex;
  justify-content: space-between;
  gap: 12px;
  align-items: center;
  margin-bottom: 10px;
}

.cliente-pedido-aviso-header a {
  text-decoration: none;
  padding: 9px 12px;
  border-radius: 999px;
  background: #ecfdf3;
  color: #15803d;
  font-size: 12px;
  font-weight: 900;
}

.cliente-pedido-aviso p {
  margin: 0;
  color: #1f1724;
  line-height: 1.55;
  font-weight: 700;
}

.cliente-pedido-direccion {
  margin-top: 12px;
  padding: 12px;
  border-radius: 16px;
  background: rgba(255, 255, 255, 0.7);
}

.cliente-pedido-direccion span {
  display: block;
  color: #8f174d;
  font-size: 11px;
  font-weight: 900;
  text-transform: uppercase;
  margin-bottom: 4px;
}

.cliente-pedido-direccion strong {
  display: block;
  color: #1f1724;
}

.cliente-pedido-direccion small {
  color: #706878;
}

.cliente-pedido-productos {
  display: grid;
  gap: 12px;
}

.cliente-pedido-tienda-productos {
  padding: 16px;
  border-radius: 20px;
  background: white;
  border: 1px solid #eadce5;
}

.cliente-pedido-tienda-productos h4 {
  margin: 0 0 12px;
  color: #1f1724;
}

.cliente-pedido-producto-item,
.cliente-pedido-total-tienda {
  display: flex;
  justify-content: space-between;
  gap: 14px;
  align-items: center;
  padding: 12px;
  border-radius: 15px;
  background: #faf7fb;
  margin-top: 8px;
}

.cliente-pedido-producto-item strong {
  color: #1f1724;
}

.cliente-pedido-producto-item p {
  margin: 4px 0 0;
  color: #706878;
  font-size: 13px;
}

.cliente-pedido-producto-item span,
.cliente-pedido-total-tienda strong {
  color: #8f174d;
  font-weight: 900;
}

.cliente-pedido-total-tienda span {
  color: #706878;
  font-size: 12px;
  font-weight: 900;
  text-transform: uppercase;
}

.cliente-pedido-acciones {
  display: flex;
  gap: 10px;
  flex-wrap: wrap;
  justify-content: flex-end;
}

@media (max-width: 850px) {
  .cliente-empresa-modal-header,
  .cliente-empresa-info-grid {
    grid-template-columns: 1fr;
  }

  .cliente-pedido-aviso-header,
  .cliente-pedido-producto-item,
  .cliente-pedido-total-tienda {
    flex-direction: column;
    align-items: flex-start;
  }

  .cliente-pedido-acciones {
    justify-content: flex-start;
  }
}

/* =========================================================
   MENÚ DESLIZABLE + ICONOS + NOTIFICACIONES
   ========================================================= */

.portal-panel,
.empresa-panel {
  transition: grid-template-columns 0.25s ease;
}

.portal-panel.menu-contraido,
.empresa-panel.menu-contraido {
  grid-template-columns: 92px 1fr;
}

.portal-sidebar,
.empresa-sidebar {
  position: relative;
  transition: width 0.25s ease, padding 0.25s ease;
}

.portal-menu-toggle,
.empresa-menu-toggle {
  position: absolute;
  top: 18px;
  right: -18px;
  z-index: 90;
  width: 38px;
  height: 38px;
  border: 1px solid #eadce5;
  border-radius: 14px;
  background: rgba(255, 255, 255, 0.96);
  color: #8f174d;
  display: grid;
  place-items: center;
  cursor: pointer;
  box-shadow: 0 12px 28px rgba(55, 19, 43, 0.12);
}

.portal-menu-toggle:hover,
.empresa-menu-toggle:hover {
  background: #fff1f7;
  transform: translateY(-1px);
}

.portal-menu-icon,
.empresa-menu-icon {
  width: 21px;
  height: 21px;
  flex: 0 0 auto;
}

.portal-sidebar nav button,
.portal-sidebar-footer .portal-volver,
.portal-cerrar-sesion,
.empresa-nav button,
.empresa-sidebar-footer button {
  display: flex !important;
  align-items: center;
  gap: 11px;
  white-space: nowrap;
  overflow: hidden;
}

.portal-sidebar nav button span,
.portal-sidebar-footer .portal-volver span,
.portal-cerrar-sesion span,
.empresa-nav button span,
.empresa-sidebar-footer button span,
.portal-logo span,
.empresa-brand h2,
.empresa-brand p,
.empresa-mini-card span,
.empresa-mini-card strong,
.empresa-mini-card p {
  transition: opacity 0.18s ease, width 0.18s ease;
}

.portal-panel.menu-contraido .portal-sidebar,
.empresa-panel.menu-contraido .empresa-sidebar {
  padding-left: 18px;
  padding-right: 18px;
  align-items: center;
}

.portal-panel.menu-contraido .portal-logo span,
.portal-panel.menu-contraido .portal-sidebar nav button span,
.portal-panel.menu-contraido .portal-sidebar-footer span,
.empresa-panel.menu-contraido .empresa-brand h2,
.empresa-panel.menu-contraido .empresa-brand p,
.empresa-panel.menu-contraido .empresa-mini-card,
.empresa-panel.menu-contraido .empresa-nav button span,
.empresa-panel.menu-contraido .empresa-sidebar-footer span {
  opacity: 0;
  width: 0;
  pointer-events: none;
}

.portal-panel.menu-contraido .portal-logo,
.empresa-panel.menu-contraido .empresa-brand {
  justify-content: center;
}

.portal-panel.menu-contraido .portal-sidebar nav button,
.portal-panel.menu-contraido .portal-sidebar-footer button,
.empresa-panel.menu-contraido .empresa-nav button,
.empresa-panel.menu-contraido .empresa-sidebar-footer button {
  justify-content: center;
  width: 56px;
  height: 50px;
  padding: 0;
}

.portal-panel.menu-contraido .portal-menu-toggle,
.empresa-panel.menu-contraido .empresa-menu-toggle {
  right: -16px;
}

/* ACCIONES FLOTANTES CLIENTE */

.cliente-top-actions {
  position: fixed;
  top: 76px;
  right: 34px;
  z-index: 90;
  display: flex;
  gap: 12px;
  align-items: flex-start;
}

.cliente-top-actions .cliente-cart-top,
.cliente-notification-top {
  position: relative !important;
  top: auto !important;
  right: auto !important;
  margin: 0 !important;
  width: 54px;
  height: 54px;
  border: 1px solid #eadce5;
  border-radius: 18px;
  background: rgba(255, 255, 255, 0.96);
  color: #8f174d;
  display: grid;
  place-items: center;
  cursor: pointer;
  box-shadow: 0 14px 35px rgba(55, 19, 43, 0.14);
  transition: 0.2s ease;
}

.cliente-top-actions .cliente-cart-top:hover,
.cliente-notification-top:hover {
  transform: translateY(-2px);
  background: #fff1f7;
}

.cliente-top-actions svg,
.cliente-notification-top svg {
  width: 24px;
  height: 24px;
}

.cliente-top-actions .cliente-cart-top span,
.cliente-notification-top span {
  position: absolute;
  top: -7px;
  right: -7px;
  min-width: 24px;
  height: 24px;
  padding: 0 7px;
  border-radius: 999px;
  background: linear-gradient(135deg, #8f174d, #c02672);
  color: white;
  display: grid;
  place-items: center;
  font-size: 12px;
  font-weight: 900;
  box-shadow: 0 8px 18px rgba(143, 23, 77, 0.28);
}

.cliente-notification-popover,
.empresa-notification-popover {
  position: absolute;
  top: 66px;
  right: 0;
  width: min(380px, calc(100vw - 40px));
  padding: 16px;
  border-radius: 24px;
  background: rgba(255, 255, 255, 0.98);
  border: 1px solid #eadce5;
  box-shadow: 0 26px 70px rgba(55, 19, 43, 0.18);
  backdrop-filter: blur(12px);
}

.cliente-notification-header,
.empresa-notification-header {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 14px;
  margin-bottom: 12px;
}

.cliente-notification-header span,
.empresa-notification-header span {
  color: #8f174d;
  font-size: 11px;
  font-weight: 900;
  text-transform: uppercase;
  letter-spacing: 1px;
}

.cliente-notification-header h3,
.empresa-notification-header h3 {
  margin: 4px 0 0;
  color: #1f1724;
  font-size: 20px;
}

.cliente-notification-header button,
.empresa-notification-header button {
  width: 32px;
  height: 32px;
  border: none;
  border-radius: 999px;
  background: #fff1f2;
  color: #be123c;
  font-size: 22px;
  font-weight: 900;
  cursor: pointer;
}

.cliente-notification-list,
.empresa-notification-list {
  display: grid;
  gap: 10px;
  max-height: 340px;
  overflow-y: auto;
  padding-right: 4px;
}

.cliente-notification-item,
.empresa-notification-item {
  padding: 13px;
  border-radius: 18px;
  background: #faf7fb;
  border: 1px solid #eadce5;
}

.cliente-notification-item strong,
.empresa-notification-item strong {
  display: block;
  color: #1f1724;
  font-size: 14px;
  line-height: 1.35;
}

.cliente-notification-item p,
.empresa-notification-item p,
.cliente-notification-empty,
.empresa-notification-empty {
  margin: 5px 0 0;
  color: #706878;
  font-size: 13px;
  line-height: 1.5;
}

.cliente-notification-item.ok,
.empresa-notification-item.ok {
  background: #ecfdf3;
  border-color: #bbf7d0;
}

.cliente-notification-item.revision,
.empresa-notification-item.revision,
.empresa-notification-item.nuevo {
  background: #fffbeb;
  border-color: #fde68a;
}

.cliente-notification-item.error,
.empresa-notification-item.error {
  background: #fff1f2;
  border-color: #fecdd3;
}

.cliente-notification-link {
  width: 100%;
  margin-top: 12px;
  border: none;
  border-radius: 15px;
  padding: 12px 14px;
  background: linear-gradient(135deg, #8f174d, #c02672);
  color: white;
  font-weight: 900;
  cursor: pointer;
}

/* NOTIFICACIONES EMPRESA */

.empresa-top-actions {
  display: flex;
  align-items: center;
  gap: 12px;
  position: relative;
}

.empresa-notification-area {
  position: relative;
}

.empresa-notification-top {
  position: relative;
  width: 48px;
  height: 48px;
  border: 1px solid #eadce5;
  border-radius: 16px;
  background: rgba(255, 255, 255, 0.96);
  color: #8f174d;
  display: grid;
  place-items: center;
  cursor: pointer;
  box-shadow: 0 12px 28px rgba(55, 19, 43, 0.1);
}

.empresa-notification-top:hover {
  background: #fff1f7;
  transform: translateY(-1px);
}

.empresa-notification-top span {
  position: absolute;
  top: -7px;
  right: -7px;
  min-width: 22px;
  height: 22px;
  padding: 0 6px;
  border-radius: 999px;
  background: linear-gradient(135deg, #8f174d, #c02672);
  color: white;
  display: grid;
  place-items: center;
  font-size: 11px;
  font-weight: 900;
}

.empresa-notification-actions {
  display: flex;
  gap: 8px;
  margin-top: 12px;
}

.empresa-notification-actions button,
.empresa-header-actions-mini button {
  border: none;
  border-radius: 12px;
  padding: 9px 12px;
  background: #f2edf1;
  color: #3e3542;
  font-size: 12px;
  font-weight: 900;
  cursor: pointer;
}

.empresa-notification-actions button:first-child,
.empresa-header-actions-mini button:first-child {
  background: #fff1f7;
  color: #8f174d;
}

.empresa-header-actions-mini {
  display: flex;
  gap: 8px;
  flex-wrap: wrap;
  justify-content: flex-end;
}

@media (max-width: 960px) {
  .portal-panel.menu-contraido,
  .empresa-panel.menu-contraido,
  .portal-panel,
  .empresa-panel {
    grid-template-columns: 1fr;
  }

  .portal-menu-toggle,
  .empresa-menu-toggle {
    right: 18px;
  }

  .cliente-top-actions {
    top: 22px;
    right: 22px;
  }

  .cliente-notification-popover {
    right: -66px;
  }
}

