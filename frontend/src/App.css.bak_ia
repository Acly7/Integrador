/* ===== ADMIN ZIP 2: NUEVO ADMIN Y MI CUENTA MÁS ORDENADA ===== */

.admin-grupo-header-lado {
  display: flex;
  align-items: center;
  gap: 10px;
  flex-wrap: wrap;
  justify-content: flex-end;
}

.admin-grupo-header-lado > strong {
  min-width: 42px;
  height: 36px;
  padding: 0 12px;
  display: grid;
  place-items: center;
  border-radius: 999px;
  background: #fff1f7;
  color: #8f174d;
  font-weight: 900;
}

.admin-add-admin-btn {
  border: none;
  border-radius: 14px;
  padding: 11px 14px;
  background: linear-gradient(135deg, #8f174d, #c02672);
  color: #ffffff;
  font-weight: 900;
  cursor: pointer;
  box-shadow: 0 10px 24px rgba(143, 23, 77, 0.16);
}

.admin-add-admin-btn:hover {
  transform: translateY(-1px);
  background: linear-gradient(135deg, #7a123f, #a81758);
}

.admin-nuevo-admin-card {
  display: grid;
  gap: 18px;
  margin-bottom: 18px;
  padding: 22px;
  border-radius: 24px;
  background: #ffffff;
  border: 1px solid #eadce5;
  box-shadow: 0 16px 38px rgba(55, 19, 43, 0.08);
}

.admin-nuevo-admin-card .admin-panel-title p {
  margin: 6px 0 0;
  color: #706878;
  line-height: 1.5;
}

.admin-cuenta-form {
  grid-template-columns: 230px minmax(0, 1fr);
  align-items: start;
}

.admin-cuenta-foto-editor {
  min-width: 0;
  overflow: hidden;
}

.admin-cuenta-foto-editor .admin-avatar {
  width: 112px;
  height: 112px;
  border-radius: 28px;
  margin-bottom: 14px;
}

.admin-cuenta-foto-editor label {
  display: grid;
  gap: 8px;
  max-width: 100%;
  color: #8f174d;
  font-size: 13px;
  font-weight: 900;
  overflow-wrap: anywhere;
}

.admin-cuenta-foto-editor input[type="file"] {
  width: 100%;
  max-width: 100%;
  min-width: 0;
  padding: 10px;
  border-radius: 14px;
  background: #ffffff;
  border: 1px solid #eadce5;
  color: #5f5264;
  font-size: 12px;
}

.admin-cuenta-foto-editor p,
.admin-cuenta-card p,
.admin-password-form p {
  overflow-wrap: anywhere;
}

.admin-cuenta-card strong,
.admin-info-lista strong,
.admin-usuario-row strong,
.admin-usuario-row p {
  overflow-wrap: anywhere;
  word-break: break-word;
}

.admin-cuenta-seguridad-horizontal {
  margin-top: 18px;
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 18px;
}

.admin-cuenta-seguridad-horizontal button,
.admin-cuenta-card.seguridad button {
  border: none;
  border-radius: 14px;
  padding: 12px 15px;
  background: #fff1f7;
  color: #8f174d;
  font-weight: 900;
  cursor: pointer;
  white-space: nowrap;
}

.admin-cuenta-seguridad-horizontal button:hover,
.admin-cuenta-card.seguridad button:hover {
  background: #fce7f3;
}

.admin-password-form {
  margin-top: 18px;
}

@media (max-width: 900px) {
  .admin-cuenta-form {
    grid-template-columns: 1fr;
  }

  .admin-cuenta-seguridad-horizontal {
    flex-direction: column;
    align-items: flex-start;
  }

  .admin-cuenta-seguridad-horizontal button {
    width: 100%;
  }
}



/* =========================================================
   ADMIN ZIP 1: listas ordenadas, usuarios y cuenta admin
   ========================================================= */

.admin-scroll-grid {
  max-height: calc(100vh - 230px);
  overflow-y: auto;
  padding-right: 6px;
}

.admin-scroll-grid::-webkit-scrollbar,
.admin-usuarios-scroll::-webkit-scrollbar,
.admin-productos-scroll::-webkit-scrollbar {
  width: 7px;
}

.admin-scroll-grid::-webkit-scrollbar-thumb,
.admin-usuarios-scroll::-webkit-scrollbar-thumb,
.admin-productos-scroll::-webkit-scrollbar-thumb {
  background: rgba(143, 23, 77, 0.22);
  border-radius: 999px;
}

.admin-usuarios-grupos-grid {
  display: grid;
  grid-template-columns: repeat(3, minmax(0, 1fr));
  gap: 18px;
  align-items: start;
}

.admin-usuarios-grupo,
.admin-categoria-admin,
.admin-cuenta-principal,
.admin-cuenta-card,
.admin-cuenta-form,
.admin-password-form,
.admin-empresa-selector-card {
  background: rgba(255, 255, 255, 0.96);
  border: 1px solid #eadce5;
  border-radius: 24px;
  box-shadow: 0 14px 35px rgba(55, 19, 43, 0.06);
}

.admin-usuarios-grupo {
  overflow: hidden;
}

.admin-grupo-header,
.admin-categoria-titulo {
  padding: 18px;
  border-bottom: 1px solid #f2dce7;
  display: flex;
  justify-content: space-between;
  align-items: center;
  gap: 14px;
  background: linear-gradient(135deg, #fff7fb, #ffffff);
}

.admin-grupo-header span,
.admin-categoria-titulo span,
.admin-cuenta-principal span,
.admin-cuenta-card span,
.admin-detalle-modal > span {
  color: #8f174d;
  font-size: 11px;
  font-weight: 900;
  text-transform: uppercase;
  letter-spacing: 1px;
}

.admin-grupo-header h3,
.admin-categoria-titulo h3 {
  margin: 5px 0 0;
  color: #1f1724;
  font-size: 20px;
}

.admin-grupo-header strong,
.admin-categoria-titulo strong {
  min-width: 40px;
  height: 40px;
  border-radius: 14px;
  display: grid;
  place-items: center;
  background: #fff1f7;
  color: #8f174d;
  font-weight: 900;
}

.admin-usuarios-scroll {
  max-height: 520px;
  overflow-y: auto;
  padding: 12px;
  display: grid;
  gap: 10px;
}

.admin-usuario-row {
  padding: 14px;
  border-radius: 18px;
  background: #faf7fb;
  border: 1px solid #f2dce7;
  display: grid;
  gap: 12px;
}

.admin-user-cell p,
.admin-usuario-meta span,
.admin-vacio-texto {
  margin: 4px 0 0;
  color: #706878;
  font-size: 13px;
}

.admin-usuario-meta {
  display: flex;
  justify-content: space-between;
  gap: 10px;
  align-items: center;
}

.admin-mini-acciones,
.admin-empresa-acciones,
.admin-pago-acciones,
.admin-header-botones {
  display: flex;
  gap: 8px;
  flex-wrap: wrap;
}

.admin-mini-acciones.derecha,
.admin-header-botones {
  justify-content: flex-end;
}

.admin-mini-acciones.izquierda {
  justify-content: flex-start;
  margin-top: 12px;
}

.admin-mini-acciones button,
.admin-empresa-acciones button,
.admin-pago-acciones button,
.admin-header-botones button,
.admin-cuenta-card button {
  border: none;
  border-radius: 12px;
  padding: 9px 12px;
  font-size: 12px;
  font-weight: 900;
  cursor: pointer;
}

.admin-mini-acciones .ver,
.admin-empresa-acciones .ver,
.admin-pago-acciones button,
.admin-header-botones button {
  background: #eef2ff;
  color: #3730a3;
}

.admin-mini-acciones .aprobar,
.admin-empresa-acciones .aprobar {
  background: #ecfdf3;
  color: #15803d;
}

.admin-mini-acciones .deshabilitar,
.admin-empresa-acciones .deshabilitar {
  background: #fffbeb;
  color: #b45309;
}

.admin-mini-acciones .eliminar {
  background: #fff1f2;
  color: #be123c;
}

.admin-empresa-acciones .pendiente {
  background: #f2edf1;
  color: #3e3542;
}

.admin-empresa-grupos-lista {
  display: grid;
  gap: 18px;
}

.admin-productos-scroll {
  max-height: 460px;
  overflow-y: auto;
  padding: 16px;
}

.admin-producto-img.grande {
  width: 100%;
  height: 280px;
  border-radius: 22px;
  overflow: hidden;
  background: #fff1f7;
  display: grid;
  place-items: center;
  color: #8f174d;
  font-weight: 900;
}

.admin-producto-img.grande img {
  width: 100%;
  height: 100%;
  object-fit: contain;
}

.admin-empresa-selector-grid {
  display: grid;
  grid-template-columns: repeat(auto-fill, minmax(260px, 1fr));
  gap: 16px;
}

.admin-empresa-selector-card {
  border: 1px solid #eadce5;
  padding: 20px;
  text-align: left;
  cursor: pointer;
  transition: 0.2s ease;
}

.admin-empresa-selector-card:hover {
  transform: translateY(-3px);
  box-shadow: 0 22px 48px rgba(55, 19, 43, 0.12);
  border-color: #f8cfe1;
}

.admin-empresa-selector-card span {
  color: #8f174d;
  font-size: 11px;
  font-weight: 900;
  text-transform: uppercase;
  letter-spacing: 1px;
}

.admin-empresa-selector-card h3 {
  margin: 8px 0;
  color: #1f1724;
  font-size: 22px;
}

.admin-empresa-selector-card p {
  margin: 0 0 12px;
  color: #706878;
}

.admin-empresa-selector-card strong {
  color: #8f174d;
  font-size: 24px;
}

.admin-items-lista.compacta div {
  padding: 11px 12px;
}

.admin-cuenta-grid {
  display: grid;
  grid-template-columns: 1.2fr 1fr 1fr;
  gap: 18px;
}

.admin-cuenta-principal,
.admin-cuenta-card,
.admin-cuenta-form,
.admin-password-form {
  padding: 22px;
}

.admin-cuenta-principal {
  grid-row: span 2;
  display: grid;
  gap: 12px;
  align-content: start;
}

.admin-cuenta-principal .admin-avatar {
  width: 96px;
  height: 96px;
  border-radius: 26px;
  font-size: 34px;
}

.admin-cuenta-principal h3 {
  margin: 0;
  color: #1f1724;
  font-size: 30px;
}

.admin-cuenta-principal p,
.admin-cuenta-card p,
.admin-cuenta-foto-editor p {
  margin: 0;
  color: #706878;
  line-height: 1.55;
}

.admin-cuenta-card strong {
  display: block;
  margin: 9px 0;
  color: #1f1724;
  font-size: 18px;
}

.admin-cuenta-card.seguridad button {
  margin-top: 14px;
  background: #fff1f7;
  color: #8f174d;
}

.admin-cuenta-form {
  display: grid;
  grid-template-columns: 230px 1fr;
  gap: 22px;
}

.admin-cuenta-foto-editor {
  padding: 18px;
  border-radius: 22px;
  background: #fff1f7;
  height: fit-content;
  display: grid;
  gap: 12px;
}

.admin-cuenta-foto-editor .admin-avatar {
  width: 120px;
  height: 120px;
  border-radius: 30px;
  font-size: 42px;
}

.admin-cuenta-foto-editor label {
  color: #8f174d;
  font-weight: 900;
  display: grid;
  gap: 8px;
}

.admin-cuenta-foto-editor input {
  border: 1px solid #eadce5;
  border-radius: 14px;
  padding: 10px;
  background: white;
}

.admin-password-form {
  margin-top: 18px;
  display: grid;
  gap: 16px;
}

.admin-detalle-modal-fondo {
  position: fixed;
  inset: 0;
  z-index: 1600;
  padding: 28px;
  background: rgba(31, 23, 36, 0.68);
  display: grid;
  place-items: center;
  backdrop-filter: blur(10px);
}

.admin-detalle-modal {
  position: relative;
  width: min(820px, 96vw);
  max-height: 90vh;
  overflow-y: auto;
  padding: 24px;
  border-radius: 28px;
  background: white;
  border: 1px solid #eadce5;
  box-shadow: 0 32px 90px rgba(0, 0, 0, 0.28);
}

.admin-detalle-modal h2 {
  margin: 6px 0 18px;
  color: #1f1724;
  font-size: 30px;
}

.admin-modal-cerrar {
  position: absolute;
  top: 14px;
  right: 14px;
  width: 38px;
  height: 38px;
  border: none;
  border-radius: 999px;
  background: #fff1f2;
  color: #be123c;
  font-size: 24px;
  font-weight: 900;
  cursor: pointer;
}

.admin-detalle-layout,
.admin-detalle-producto {
  display: grid;
  grid-template-columns: 130px 1fr;
  gap: 20px;
  align-items: start;
}

.admin-detalle-layout .admin-avatar {
  width: 110px;
  height: 110px;
  border-radius: 30px;
  font-size: 40px;
}

@media (max-width: 1050px) {
  .admin-usuarios-grupos-grid,
  .admin-cuenta-grid,
  .admin-cuenta-form,
  .admin-detalle-layout,
  .admin-detalle-producto {
    grid-template-columns: 1fr;
  }

  .admin-usuarios-scroll,
  .admin-scroll-grid,
  .admin-productos-scroll {
    max-height: none;
  }
}


/* ===== ADMIN ZIP 2: NUEVO ADMIN Y MI CUENTA MÁS ORDENADA ===== */

.admin-grupo-header-lado {
  display: flex;
  align-items: center;
  gap: 10px;
  flex-wrap: wrap;
  justify-content: flex-end;
}

.admin-grupo-header-lado > strong {
  min-width: 42px;
  height: 36px;
  padding: 0 12px;
  display: grid;
  place-items: center;
  border-radius: 999px;
  background: #fff1f7;
  color: #8f174d;
  font-weight: 900;
}

.admin-add-admin-btn {
  border: none;
  border-radius: 14px;
  padding: 11px 14px;
  background: linear-gradient(135deg, #8f174d, #c02672);
  color: #ffffff;
  font-weight: 900;
  cursor: pointer;
  box-shadow: 0 10px 24px rgba(143, 23, 77, 0.16);
}

.admin-add-admin-btn:hover {
  transform: translateY(-1px);
  background: linear-gradient(135deg, #7a123f, #a81758);
}

.admin-nuevo-admin-card {
  display: grid;
  gap: 18px;
  margin-bottom: 18px;
  padding: 22px;
  border-radius: 24px;
  background: #ffffff;
  border: 1px solid #eadce5;
  box-shadow: 0 16px 38px rgba(55, 19, 43, 0.08);
}

.admin-nuevo-admin-card .admin-panel-title p {
  margin: 6px 0 0;
  color: #706878;
  line-height: 1.5;
}

.admin-cuenta-form {
  grid-template-columns: 230px minmax(0, 1fr);
  align-items: start;
}

.admin-cuenta-foto-editor {
  min-width: 0;
  overflow: hidden;
}

.admin-cuenta-foto-editor .admin-avatar {
  width: 112px;
  height: 112px;
  border-radius: 28px;
  margin-bottom: 14px;
}

.admin-cuenta-foto-editor label {
  display: grid;
  gap: 8px;
  max-width: 100%;
  color: #8f174d;
  font-size: 13px;
  font-weight: 900;
  overflow-wrap: anywhere;
}

.admin-cuenta-foto-editor input[type="file"] {
  width: 100%;
  max-width: 100%;
  min-width: 0;
  padding: 10px;
  border-radius: 14px;
  background: #ffffff;
  border: 1px solid #eadce5;
  color: #5f5264;
  font-size: 12px;
}

.admin-cuenta-foto-editor p,
.admin-cuenta-card p,
.admin-password-form p {
  overflow-wrap: anywhere;
}

.admin-cuenta-card strong,
.admin-info-lista strong,
.admin-usuario-row strong,
.admin-usuario-row p {
  overflow-wrap: anywhere;
  word-break: break-word;
}

.admin-cuenta-seguridad-horizontal {
  margin-top: 18px;
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 18px;
}

.admin-cuenta-seguridad-horizontal button,
.admin-cuenta-card.seguridad button {
  border: none;
  border-radius: 14px;
  padding: 12px 15px;
  background: #fff1f7;
  color: #8f174d;
  font-weight: 900;
  cursor: pointer;
  white-space: nowrap;
}

.admin-cuenta-seguridad-horizontal button:hover,
.admin-cuenta-card.seguridad button:hover {
  background: #fce7f3;
}

.admin-password-form {
  margin-top: 18px;
}

@media (max-width: 900px) {
  .admin-cuenta-form {
    grid-template-columns: 1fr;
  }

  .admin-cuenta-seguridad-horizontal {
    flex-direction: column;
    align-items: flex-start;
  }

  .admin-cuenta-seguridad-horizontal button {
    width: 100%;
  }
}


/* =========================================================
   ZIP 3: SOPORTE TÉCNICO + TÉRMINOS Y CONDICIONES
   ========================================================= */

.soporte-login-box {
  display: flex;
  justify-content: space-between;
  align-items: center;
  gap: 12px;
  padding: 13px 15px;
  margin-bottom: 16px;
  border-radius: 18px;
  background: #fff1f7;
  border: 1px solid #f8cfe1;
}

.soporte-login-box p {
  margin: 0;
  color: #706878;
  font-size: 13px;
  line-height: 1.45;
}

.soporte-login-box button {
  flex: 0 0 auto;
  border: none;
  border-radius: 13px;
  padding: 11px 13px;
  background: white;
  color: #8f174d;
  font-weight: 900;
  cursor: pointer;
  box-shadow: 0 10px 22px rgba(55, 19, 43, 0.08);
}

.soporte-login-box button:hover {
  background: #fce7f3;
}

.terminos-acceso-card {
  display: grid;
  gap: 14px;
  padding: 16px;
  border-radius: 20px;
  background: #faf7fb;
  border: 1px solid #eadce5;
  text-align: left;
}

.terminos-acceso-card strong {
  display: block;
  color: #1f1724;
  margin-bottom: 6px;
}

.terminos-acceso-card p {
  margin: 0;
  color: #706878;
  line-height: 1.55;
  font-size: 13.5px;
}

.terminos-acceso-card button {
  margin-top: 10px;
  border: none;
  background: transparent;
  color: #8f174d;
  font-weight: 900;
  cursor: pointer;
  padding: 0;
}

.terminos-acceso-card label {
  display: flex;
  align-items: flex-start;
  gap: 10px;
  padding: 12px;
  border-radius: 16px;
  background: white;
  border: 1px solid #eadce5;
  color: #1f1724;
  font-weight: 800;
  line-height: 1.4;
  cursor: pointer;
}

.terminos-acceso-card input {
  width: 18px;
  height: 18px;
  margin-top: 1px;
  accent-color: #8f174d;
}

.login-modal-fondo {
  position: fixed;
  inset: 0;
  z-index: 3000;
  display: grid;
  place-items: center;
  padding: 24px;
  background: rgba(31, 23, 36, 0.62);
  backdrop-filter: blur(10px);
}

.login-modal-card {
  position: relative;
  width: min(760px, 96vw);
  max-height: min(88vh, 760px);
  overflow-y: auto;
  padding: 28px;
  border-radius: 30px;
  background: rgba(255, 255, 255, 0.98);
  border: 1px solid rgba(255, 255, 255, 0.9);
  box-shadow: 0 32px 90px rgba(0, 0, 0, 0.28);
}

.login-modal-card > span {
  color: #8f174d;
  font-size: 12px;
  font-weight: 900;
  text-transform: uppercase;
  letter-spacing: 1.3px;
}

.login-modal-card h2 {
  margin: 8px 0 10px;
  color: #1f1724;
  font-size: 30px;
}

.login-modal-card p {
  color: #706878;
  line-height: 1.6;
}

.login-modal-cerrar {
  position: absolute;
  top: 14px;
  right: 14px;
  width: 40px;
  height: 40px;
  border: none;
  border-radius: 999px;
  background: #fff1f2;
  color: #be123c;
  font-size: 26px;
  font-weight: 900;
  cursor: pointer;
}

.login-modal-card select {
  width: 100%;
  min-height: 50px;
  border: 1px solid var(--borde);
  border-radius: 15px;
  padding: 0 15px;
  background: white;
  color: var(--texto);
  outline: none;
}

.login-modal-card select:focus {
  border-color: var(--vino);
  box-shadow: 0 0 0 4px rgba(143, 23, 77, 0.11);
}

.terminos-texto-scroll {
  max-height: 340px;
  overflow-y: auto;
  display: grid;
  gap: 12px;
  padding: 16px;
  margin: 14px 0;
  border-radius: 18px;
  background: #faf7fb;
  border: 1px solid #eadce5;
}

.terminos-texto-scroll p {
  margin: 0;
  color: #4c4350;
}

.btn-principal:disabled {
  opacity: 0.55;
  cursor: not-allowed;
  transform: none !important;
}

@media (max-width: 620px) {
  .soporte-login-box {
    flex-direction: column;
    align-items: stretch;
  }

  .login-modal-card {
    padding: 22px;
  }
}



/* =========================================================
   ADMIN ZIP 1: listas ordenadas, usuarios y cuenta admin
   ========================================================= */

.admin-scroll-grid {
