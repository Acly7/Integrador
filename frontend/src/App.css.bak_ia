@import url("https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&family=Playfair+Display:wght@700;800&display=swap");

* {
  box-sizing: border-box;
}

:root {
  --vino: #8f174d;
  --vino-oscuro: #5f0f33;
  --rosa: #e879b4;
  --rosa-suave: #fff1f7;
  --fondo: #fbf8fc;
  --texto: #1f1724;
  --gris: #706878;
  --borde: #eadce5;
  --blanco: #ffffff;
  --sombra: 0 24px 70px rgba(55, 19, 43, 0.16);
}

html,
body,
#root {
  margin: 0;
  width: 100%;
  height: 100%;
  overflow: hidden;
}

body {
  font-family: "Inter", sans-serif;
  color: var(--texto);
  background:
    radial-gradient(circle at 10% 10%, rgba(232, 121, 180, 0.26), transparent 30%),
    radial-gradient(circle at 90% 90%, rgba(190, 172, 255, 0.22), transparent 30%),
    linear-gradient(135deg, #fffafb, #f8f2ff);
}

button,
input,
textarea,
select {
  font-family: inherit;
}

/* LOGIN */

.pagina {
  width: 100%;
  height: 100vh;
  padding: 28px;
  display: flex;
  align-items: flex-start;
  justify-content: center;
  overflow: hidden;
}

.contenedor {
  width: 100%;
  max-width: 1160px;
  height: calc(100vh - 56px);
  display: grid;
  grid-template-columns: 1.08fr 0.92fr;
  gap: 34px;
  align-items: flex-start;
  overflow: hidden;
}

.panel-info {
  height: 100%;
  padding: 34px;
  border-radius: 32px;
  background:
    linear-gradient(145deg, rgba(255, 255, 255, 0.74), rgba(255, 241, 247, 0.78));
  border: 1px solid rgba(255, 255, 255, 0.9);
  box-shadow: 0 20px 60px rgba(55, 19, 43, 0.1);
  backdrop-filter: blur(18px);
  overflow-y: auto;
  overflow-x: hidden;
}

.panel-info::-webkit-scrollbar,
.formulario-scroll::-webkit-scrollbar,
.bienvenida::-webkit-scrollbar {
  width: 7px;
}

.panel-info::-webkit-scrollbar-thumb,
.formulario-scroll::-webkit-scrollbar-thumb,
.bienvenida::-webkit-scrollbar-thumb {
  background: rgba(143, 23, 77, 0.22);
  border-radius: 999px;
}

.marca {
  display: flex;
  align-items: center;
  gap: 14px;
}

.logo {
  width: 44px;
  height: 44px;
  border-radius: 15px;
  background: linear-gradient(135deg, var(--vino), var(--rosa));
  color: var(--blanco);
  display: grid;
  place-items: center;
  font-weight: 800;
  font-size: 23px;
  box-shadow: 0 12px 26px rgba(143, 23, 77, 0.25);
}

.marca span {
  font-weight: 800;
  letter-spacing: 5px;
  color: var(--vino);
  font-size: 14px;
}

.texto-principal {
  margin-top: 34px;
}

.subtitulo {
  margin: 0 0 12px;
  color: var(--vino);
  font-weight: 800;
  font-size: 13px;
  letter-spacing: 1.3px;
  text-transform: uppercase;
}

.texto-principal h1 {
  margin: 0;
  font-family: "Playfair Display", serif;
  font-size: clamp(38px, 4.2vw, 58px);
  line-height: 1;
  letter-spacing: -1.4px;
  color: var(--texto);
}

.descripcion {
  max-width: 560px;
  margin: 20px 0 0;
  color: #504757;
  font-size: 16px;
  line-height: 1.62;
}

.info-lista {
  margin-top: 28px;
  display: grid;
  gap: 12px;
  padding-bottom: 10px;
}

.info-item {
  display: grid;
  grid-template-columns: 38px 1fr;
  gap: 14px;
  align-items: start;
  padding: 14px;
  border-radius: 20px;
  background: rgba(255, 255, 255, 0.68);
  border: 1px solid rgba(255, 255, 255, 0.95);
}

.icono-info {
  width: 22px;
  height: 22px;
  color: var(--vino);
  margin-top: 4px;
}

.info-item h3 {
  margin: 0 0 4px;
  font-size: 14px;
  color: var(--texto);
}

.info-item p {
  margin: 0;
  color: var(--gris);
  font-size: 13.5px;
  line-height: 1.45;
}

.frase {
  margin: 24px 0 4px;
  color: var(--vino);
  font-weight: 800;
  font-size: 14.5px;
}

.auth-card {
  width: 100%;
  max-height: 100%;
  align-self: flex-start;
  padding: 36px;
  border-radius: 32px;
  background: rgba(255, 255, 255, 0.97);
  border: 1px solid rgba(255, 255, 255, 0.92);
  box-shadow: var(--sombra);
  backdrop-filter: blur(18px);
  overflow: hidden;
}

.auth-header {
  margin-bottom: 24px;
  text-align: center;
}

.mini-texto {
  margin: 0 0 9px;
  color: var(--vino);
  font-size: 12.5px;
  font-weight: 800;
  letter-spacing: 1.3px;
  text-transform: uppercase;
}

.auth-header h2,
.bienvenida h2 {
  margin: 0;
  font-size: 31px;
  letter-spacing: -0.8px;
  color: var(--texto);
}

.auth-header p {
  margin: 9px auto 0;
  max-width: 360px;
  color: var(--gris);
  line-height: 1.5;
  font-size: 14.5px;
}

.tabs-auth {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 8px;
  padding: 6px;
  margin-bottom: 18px;
  border-radius: 18px;
  background: #f8edf3;
}

.tabs-auth button {
  height: 42px;
  border: none;
  border-radius: 14px;
  background: transparent;
  color: #706878;
  font-weight: 900;
  cursor: pointer;
  transition: 0.2s ease;
}

.tabs-auth button.activo {
  background: white;
  color: #8f174d;
  box-shadow: 0 10px 24px rgba(55, 19, 43, 0.08);
}

.formulario {
  display: grid;
  gap: 16px;
}

.formulario-scroll {
  max-height: 430px;
  overflow-y: auto;
  overflow-x: hidden;
  padding-right: 6px;
  padding-bottom: 20px;
}

.grid-dos {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 12px;
}

.campo {
  display: grid;
  gap: 7px;
}

.campo label {
  font-size: 13.5px;
  font-weight: 700;
  color: #342b39;
}

.campo input,
.campo textarea {
  width: 100%;
  border: 1px solid var(--borde);
  border-radius: 15px;
  background: var(--blanco);
  color: var(--texto);
  outline: none;
  font-size: 14.5px;
  transition: 0.2s ease;
}

.campo input {
  height: 50px;
  padding: 0 15px;
}

.campo textarea {
  min-height: 82px;
  resize: vertical;
  padding: 13px 15px;
}

.campo input:focus,
.campo textarea:focus {
  border-color: var(--vino);
  box-shadow: 0 0 0 4px rgba(143, 23, 77, 0.11);
}

.password-box {
  position: relative;
}

.password-box input {
  padding-right: 52px;
}

.btn-ojo {
  position: absolute;
  right: 8px;
  top: 50%;
  width: 38px;
  height: 38px;
  transform: translateY(-50%);
  border: none;
  border-radius: 12px;
  background: transparent;
  color: #766b78;
  display: grid;
  place-items: center;
  cursor: pointer;
  transition: 0.2s ease;
}

.btn-ojo:hover {
  background: var(--rosa-suave);
  color: var(--vino);
}

.icono-ojo {
  width: 21px;
  height: 21px;
}

.btn-principal {
  height: 52px;
  border: none;
  border-radius: 16px;
  background: linear-gradient(135deg, var(--vino), #c02672);
  color: var(--blanco);
  font-size: 15.5px;
  font-weight: 800;
  cursor: pointer;
  box-shadow: 0 14px 30px rgba(143, 23, 77, 0.22);
  transition: 0.2s ease;
}

.btn-principal:hover {
  transform: translateY(-1px);
  background: linear-gradient(135deg, var(--vino-oscuro), var(--vino));
}

.btn-principal:disabled {
  opacity: 0.65;
  cursor: not-allowed;
  transform: none;
}

.auth-links {
  text-align: center;
  margin-top: 0;
}

.auth-links button {
  border: none;
  background: transparent;
  color: var(--vino);
  font-weight: 800;
  cursor: pointer;
  font-size: 14px;
}

.auth-links button:hover {
  text-decoration: underline;
}

.mensaje {
  margin: 0 0 16px;
  padding: 12px 14px;
  border-radius: 15px;
  text-align: center;
  font-size: 13.5px;
  font-weight: 700;
}

.mensaje.ok {
  background: #ecfdf3;
  color: #15803d;
  border: 1px solid #bbf7d0;
}

.mensaje.error {
  background: #fff1f2;
  color: #be123c;
  border: 1px solid #fecdd3;
}

.bienvenida {
  text-align: center;
  padding: 4px 0;
  max-height: 100%;
  overflow-y: auto;
  padding-right: 4px;
  display: grid;
  gap: 12px;
}

.bienvenida-icono {
  width: 70px;
  height: 70px;
  margin: 0 auto 18px;
  border-radius: 22px;
  background: linear-gradient(135deg, var(--vino), var(--rosa));
  color: var(--blanco);
  display: grid;
  place-items: center;
  font-size: 31px;
  font-weight: 800;
  box-shadow: 0 16px 32px rgba(143, 23, 77, 0.22);
}

.bienvenida-icono.pendiente {
  background: linear-gradient(135deg, #d97706, #f59e0b);
}

.bienvenida-icono.aprobada {
  background: linear-gradient(135deg, #15803d, #22c55e);
}

.bienvenida-icono.deshabilitada {
  background: linear-gradient(135deg, #991b1b, #ef4444);
}

.bienvenida-texto {
  margin: 16px 0;
  color: var(--gris);
  line-height: 1.65;
  font-size: 14.5px;
}

.bienvenida-extra {
  padding: 14px;
  border-radius: 17px;
  background: var(--rosa-suave);
  color: var(--vino);
  font-weight: 800;
  font-size: 13.5px;
  margin: 17px 0 22px;
}

.bienvenida-extra.pendiente {
  background: #fffbeb;
  color: #b45309;
}

.bienvenida-extra.aprobada {
  background: #ecfdf3;
  color: #15803d;
}

.bienvenida-extra.deshabilitada {
  background: #fff1f2;
  color: #be123c;
}

.caja-ayuda {
  text-align: left;
  padding: 16px;
  border-radius: 18px;
  background: #fffbeb;
  border: 1px solid #fde68a;
  color: #78350f;
}

.caja-ayuda.alerta {
  background: #fff1f2;
  border-color: #fecdd3;
  color: #991b1b;
}

.caja-ayuda strong {
  display: block;
  margin-bottom: 6px;
  font-size: 14px;
}

.caja-ayuda p {
  margin: 0;
  font-size: 14px;
  line-height: 1.55;
}

.btn-secundario {
  height: 46px;
  padding: 0 22px;
  border: none;
  border-radius: 15px;
  background: #f2edf1;
  color: #3e3542;
  font-weight: 800;
  cursor: pointer;
  transition: 0.2s ease;
}

.btn-secundario:hover {
  background: #e8dde5;
}

/* PANEL EMPRESARIAL */

.empresa-panel {
  width: 100vw;
  height: 100vh;
  display: grid;
  grid-template-columns: 290px 1fr;
  background:
    radial-gradient(circle at top left, rgba(232, 121, 180, 0.18), transparent 34%),
    linear-gradient(135deg, #fffafb, #f8f2ff);
  overflow: hidden;
  font-family: "Inter", sans-serif;
  color: #1f1724;
}

.empresa-sidebar {
  height: 100vh;
  background: rgba(255, 255, 255, 0.96);
  border-right: 1px solid #eadce5;
  padding: 26px;
  display: flex;
  flex-direction: column;
  gap: 22px;
  box-shadow: 10px 0 40px rgba(55, 19, 43, 0.06);
}

.empresa-brand {
  display: flex;
  align-items: center;
  gap: 13px;
}

.empresa-brand-icon {
  width: 46px;
  height: 46px;
  border-radius: 16px;
  background: linear-gradient(135deg, #8f174d, #e879b4);
  color: white;
  display: grid;
  place-items: center;
  font-size: 24px;
  font-weight: 900;
}

.empresa-brand h2 {
  margin: 0;
  color: #8f174d;
  font-size: 24px;
}

.empresa-brand p {
  margin: 2px 0 0;
  color: #706878;
  font-size: 13px;
}

.empresa-mini-card {
  padding: 18px;
  border-radius: 22px;
  background: #fff1f7;
  border: 1px solid #f8cfe1;
}

.empresa-mini-card span {
  display: block;
  font-size: 12px;
  color: #8f174d;
  font-weight: 800;
  text-transform: uppercase;
  letter-spacing: 1px;
  margin-bottom: 8px;
}

.empresa-mini-card strong {
  display: block;
  color: #1f1724;
  font-size: 17px;
}

.empresa-mini-card p {
  margin: 7px 0 0;
  color: #15803d;
  font-weight: 800;
  font-size: 13px;
}

.empresa-nav {
  display: grid;
  gap: 8px;
}

.empresa-nav button {
  width: 100%;
  border: none;
  text-align: left;
  padding: 13px 14px;
  border-radius: 15px;
  background: transparent;
  color: #706878;
  font-weight: 800;
  cursor: pointer;
  transition: 0.2s ease;
  font-size: 14px;
}

.empresa-nav button:hover,
.empresa-nav button.activo {
  background: #fff1f7;
  color: #8f174d;
}

.empresa-sidebar-footer {
  margin-top: auto;
  display: grid;
  gap: 8px;
}

.empresa-sidebar-footer button {
  border: none;
  border-radius: 15px;
  padding: 13px;
  font-weight: 800;
  cursor: pointer;
  background: #f2edf1;
  color: #3e3542;
}

.empresa-main {
  height: 100vh;
  overflow-y: auto;
  padding: 30px;
}

.empresa-topbar {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 28px;
}

.empresa-topbar p {
  margin: 0 0 5px;
  color: #8f174d;
  font-weight: 800;
  text-transform: uppercase;
  font-size: 12px;
  letter-spacing: 1.2px;
}

.empresa-topbar h1 {
  margin: 0;
  color: #1f1724;
  font-size: 36px;
  letter-spacing: -1px;
}

.empresa-estado {
  padding: 10px 16px;
  border-radius: 999px;
  background: #ecfdf3;
  color: #15803d;
  font-weight: 900;
  font-size: 13px;
}

.empresa-section {
  display: grid;
  gap: 22px;
}

.tienda-preview {
  padding: 28px;
  border-radius: 28px;
  background: linear-gradient(135deg, #8f174d, #c02672);
  color: white;
  display: flex;
  justify-content: space-between;
  align-items: center;
  gap: 22px;
  box-shadow: 0 24px 60px rgba(143, 23, 77, 0.22);
}

.tienda-preview span,
.section-header span {
  font-size: 12px;
  font-weight: 900;
  text-transform: uppercase;
  letter-spacing: 1.4px;
  opacity: 0.85;
}

.tienda-preview h2 {
  margin: 8px 0;
  font-size: 34px;
}

.tienda-preview p {
  margin: 0;
  max-width: 620px;
  line-height: 1.6;
  opacity: 0.92;
}

.tienda-preview button,
.section-header button {
  border: none;
  padding: 13px 18px;
  border-radius: 15px;
  font-weight: 900;
  cursor: pointer;
  background: white;
  color: #8f174d;
}

.productos-grid {
  display: grid;
  grid-template-columns: repeat(auto-fill, minmax(230px, 1fr));
  gap: 18px;
}

.producto-card {
  background: white;
  border: 1px solid #eadce5;
  border-radius: 24px;
  overflow: hidden;
  box-shadow: 0 16px 38px rgba(55, 19, 43, 0.08);
}

.producto-imagen {
  height: 190px;
  background: #fff1f7;
  display: grid;
  place-items: center;
  color: #8f174d;
  font-weight: 800;
}

.producto-imagen img {
  width: 100%;
  height: 100%;
  object-fit: cover;
}

.producto-info {
  padding: 17px;
}

.producto-categoria {
  margin: 0 0 7px;
  color: #8f174d;
  font-size: 12px;
  font-weight: 900;
  text-transform: uppercase;
}

.producto-info h3 {
  margin: 0;
  font-size: 17px;
  color: #1f1724;
}

.producto-descripcion {
  min-height: 42px;
  margin: 8px 0;
  color: #706878;
  font-size: 13px;
  line-height: 1.45;
}

.producto-meta {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-top: 12px;
}

.producto-meta strong {
  color: #1f1724;
}

.producto-meta span {
  padding: 5px 9px;
  border-radius: 999px;
  background: #ecfdf3;
  color: #15803d;
  font-weight: 800;
  font-size: 11px;
}

.producto-variantes {
  margin-top: 12px;
  display: flex;
  flex-wrap: wrap;
  gap: 6px;
}

.producto-variantes span {
  padding: 6px 8px;
  border-radius: 999px;
  background: #f8edf3;
  color: #8f174d;
  font-size: 11px;
  font-weight: 800;
}

.section-header {
  padding: 24px;
  border-radius: 24px;
  background: white;
  border: 1px solid #eadce5;
  display: flex;
  justify-content: space-between;
  align-items: center;
}

.section-header h2 {
  margin: 5px 0 0;
  font-size: 28px;
}

.tabla-productos {
  display: grid;
  gap: 10px;
}

.fila-producto {
  padding: 18px;
  border-radius: 18px;
  background: white;
  border: 1px solid #eadce5;
  display: grid;
  grid-template-columns: 1fr 100px 100px 310px;
  gap: 12px;
  align-items: center;
}

.fila-producto strong {
  color: #1f1724;
}

.fila-producto p {
  margin: 5px 0 0;
  color: #706878;
  font-size: 13px;
}

.vacio-card,
.estado-carga,
.estado-error {
  padding: 24px;
  border-radius: 22px;
  background: white;
  border: 1px solid #eadce5;
  color: #706878;
}

.vacio-card h3 {
  margin-top: 0;
  color: #1f1724;
}

.estado-error {
  color: #be123c;
  background: #fff1f2;
  border-color: #fecdd3;
}

/* FORMULARIOS PRODUCTO */

.producto-form {
  background: white;
  border: 1px solid #eadce5;
  border-radius: 26px;
  padding: 26px;
  box-shadow: 0 18px 45px rgba(55, 19, 43, 0.07);
  display: grid;
  gap: 18px;
}

.form-grid {
  display: grid;
  grid-template-columns: repeat(2, 1fr);
  gap: 16px;
}

.campo-panel {
  display: grid;
  gap: 8px;
}

.campo-panel label {
  font-size: 14px;
  font-weight: 800;
  color: #342b39;
}

.campo-panel input,
.campo-panel select,
.campo-panel textarea {
  width: 100%;
  border: 1px solid #eadce5;
  border-radius: 15px;
  padding: 0 15px;
  min-height: 50px;
  outline: none;
  font-size: 14.5px;
  background: white;
  color: #1f1724;
}

.campo-panel textarea {
  padding: 14px 15px;
  min-height: 100px;
  resize: vertical;
}

.campo-panel input:focus,
.campo-panel select:focus,
.campo-panel textarea:focus {
  border-color: #8f174d;
  box-shadow: 0 0 0 4px rgba(143, 23, 77, 0.1);
}

.acciones-form {
  display: flex;
  gap: 12px;
  justify-content: flex-end;
}

.btn-panel-principal,
.btn-panel-secundario {
  border: none;
  border-radius: 15px;
  padding: 14px 20px;
  font-weight: 900;
  cursor: pointer;
}

.btn-panel-principal {
  background: linear-gradient(135deg, #8f174d, #c02672);
  color: white;
}

.btn-panel-secundario {
  background: #f2edf1;
  color: #3e3542;
}

.mensaje-producto {
  padding: 13px 15px;
  border-radius: 16px;
  font-weight: 800;
  font-size: 14px;
}

.mensaje-producto.ok {
  background: #ecfdf3;
  color: #15803d;
  border: 1px solid #bbf7d0;
}

.mensaje-producto.error {
  background: #fff1f2;
  color: #be123c;
  border: 1px solid #fecdd3;
}

/* CATEGORÍAS Y ACCIONES */

.categorias-productos {
  display: grid;
  gap: 26px;
}

.categoria-grupo {
  display: grid;
  gap: 14px;
}

.categoria-titulo {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 16px 18px;
  border-radius: 18px;
  background: white;
  border: 1px solid #eadce5;
}

.categoria-titulo h3 {
  margin: 0;
  color: #1f1724;
  font-size: 20px;
}

.categoria-titulo span {
  color: #8f174d;
  font-weight: 900;
  font-size: 13px;
}

.variante-chip {
  display: inline-flex !important;
  align-items: center;
  gap: 6px;
}

.variante-chip i {
  width: 13px;
  height: 13px;
  border-radius: 999px;
  display: inline-block;
  border: 1px solid #d1d5db;
}

.acciones-producto {
  display: flex;
  gap: 7px;
  justify-content: flex-end;
  flex-wrap: wrap;
}

.btn-ver-producto,
.btn-editar-producto,
.btn-borrar-producto,
.btn-desactivar-producto,
.btn-activar-producto {
  border: none;
  border-radius: 12px;
  padding: 9px 11px;
  font-weight: 900;
  cursor: pointer;
  font-size: 13px;
}

.btn-ver-producto {
  background: #eef2ff;
  color: #3730a3;
}

.btn-editar-producto {
  background: #fff1f7;
  color: #8f174d;
}

.btn-borrar-producto {
  background: #fff1f2;
  color: #be123c;
}

.btn-desactivar-producto {
  background: #fffbeb;
  color: #b45309;
}

.btn-activar-producto {
  background: #ecfdf3;
  color: #15803d;
}

.btn-ver-producto:hover {
  background: #e0e7ff;
}

.btn-editar-producto:hover {
  background: #fce7f3;
}

.btn-borrar-producto:hover {
  background: #ffe4e6;
}

.btn-desactivar-producto:hover {
  background: #fef3c7;
}

.btn-activar-producto:hover {
  background: #dcfce7;
}

/* DETALLE DEL PRODUCTO */

.producto-detalle {
  display: grid;
  grid-template-columns: 360px 1fr;
  gap: 24px;
  background: white;
  border: 1px solid #eadce5;
  border-radius: 28px;
  padding: 24px;
  box-shadow: 0 18px 45px rgba(55, 19, 43, 0.07);
}

.producto-detalle-imagen {
  height: 420px;
  border-radius: 24px;
  background: #fff1f7;
  display: grid;
  place-items: center;
  color: #8f174d;
  font-weight: 900;
  overflow: hidden;
}

.producto-detalle-imagen img {
  width: 100%;
  height: 100%;
  object-fit: cover;
}

.producto-detalle-info h3 {
  margin: 8px 0 12px;
  font-size: 32px;
  color: #1f1724;
}

.producto-detalle-info p {
  color: #706878;
  line-height: 1.6;
}

.detalle-datos {
  margin: 22px 0;
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 14px;
}

.detalle-datos div {
  padding: 16px;
  border-radius: 18px;
  background: #fff1f7;
}

.detalle-datos span {
  display: block;
  color: #8f174d;
  font-size: 12px;
  font-weight: 900;
  text-transform: uppercase;
  margin-bottom: 6px;
}

.detalle-datos strong {
  color: #1f1724;
}

.detalle-variantes h4 {
  margin: 0 0 12px;
  color: #1f1724;
}

.detalle-variantes {
  display: flex;
  flex-direction: column;
  gap: 8px;
}

/* VISTAS CLIENTE Y ADMIN */

.portal-panel {
  width: 100vw;
  height: 100vh;
  display: grid;
  grid-template-columns: 280px 1fr;
  background:
    radial-gradient(circle at top left, rgba(232, 121, 180, 0.18), transparent 34%),
    linear-gradient(135deg, #fffafb, #f8f2ff);
  overflow: hidden;
  font-family: "Inter", sans-serif;
}

.portal-sidebar {
  background: rgba(255, 255, 255, 0.96);
  border-right: 1px solid #eadce5;
  padding: 26px;
  display: flex;
  flex-direction: column;
  gap: 24px;
}

.portal-logo {
  display: flex;
  align-items: center;
  gap: 12px;
}

.portal-logo div {
  width: 46px;
  height: 46px;
  border-radius: 16px;
  background: linear-gradient(135deg, #8f174d, #e879b4);
  color: white;
  display: grid;
  place-items: center;
  font-weight: 900;
  font-size: 24px;
}

.portal-logo span {
  color: #8f174d;
  font-size: 22px;
  font-weight: 900;
}

.portal-sidebar nav {
  display: grid;
  gap: 8px;
}

.portal-sidebar nav button,
.portal-volver {
  border: none;
  text-align: left;
  padding: 13px 14px;
  border-radius: 15px;
  background: transparent;
  color: #706878;
  font-weight: 800;
  cursor: pointer;
}

.portal-sidebar nav button:hover,
.portal-sidebar nav button.activo {
  background: #fff1f7;
  color: #8f174d;
}

.portal-volver {
  margin-top: auto;
  background: #f2edf1;
  color: #3e3542;
  text-align: center;
}

.portal-main {
  padding: 32px;
  overflow-y: auto;
}

.portal-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 28px;
}

.portal-header p {
  margin: 0 0 6px;
  color: #8f174d;
  font-size: 12px;
  font-weight: 900;
  letter-spacing: 1.3px;
  text-transform: uppercase;
}

.portal-header h1 {
  margin: 0;
  color: #1f1724;
  font-size: 38px;
}

.portal-header button {
  border: none;
  padding: 12px 16px;
  border-radius: 14px;
  background: #f2edf1;
  color: #3e3542;
  font-weight: 900;
  cursor: pointer;
}

.cliente-hero {
  padding: 34px;
  border-radius: 30px;
  background: linear-gradient(135deg, #8f174d, #c02672);
  color: white;
  display: grid;
  grid-template-columns: 1fr 360px;
  gap: 28px;
  align-items: center;
  box-shadow: 0 24px 60px rgba(143, 23, 77, 0.22);
}

.cliente-hero span {
  font-size: 12px;
  font-weight: 900;
  text-transform: uppercase;
  letter-spacing: 1.4px;
}

.cliente-hero h2 {
  margin: 10px 0;
  font-size: 34px;
  line-height: 1.1;
}

.cliente-hero p {
  margin: 0;
  line-height: 1.6;
  opacity: 0.9;
}

.buscador-demo {
  background: white;
  padding: 14px;
  border-radius: 20px;
  display: grid;
  gap: 10px;
}

.buscador-demo input {
  height: 48px;
  border: 1px solid #eadce5;
  border-radius: 14px;
  padding: 0 14px;
  outline: none;
}

.buscador-demo button {
  height: 46px;
  border: none;
  border-radius: 14px;
  background: #8f174d;
  color: white;
  font-weight: 900;
  cursor: pointer;
}

.cliente-grid {
  margin-top: 24px;
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 18px;
}

.cliente-grid article,
.admin-cards article,
.admin-panel-preview {
  background: white;
  border: 1px solid #eadce5;
  border-radius: 24px;
  padding: 20px;
  box-shadow: 0 16px 38px rgba(55, 19, 43, 0.08);
}

.producto-demo-img {
  height: 170px;
  border-radius: 18px;
  background: #fff1f7;
  color: #8f174d;
  display: grid;
  place-items: center;
  font-weight: 900;
  margin-bottom: 14px;
}

.cliente-grid h3 {
  margin: 0;
  color: #1f1724;
}

.cliente-grid p {
  color: #706878;
  margin: 8px 0;
}

.cliente-grid strong {
  color: #8f174d;
}

.admin-cards {
  display: grid;
  grid-template-columns: repeat(4, 1fr);
  gap: 18px;
}

.admin-cards span {
  color: #8f174d;
  font-size: 12px;
  font-weight: 900;
  text-transform: uppercase;
}

.admin-cards strong {
  display: block;
  margin: 12px 0 6px;
  font-size: 36px;
  color: #1f1724;
}

.admin-cards p {
  margin: 0;
  color: #706878;
}

.admin-panel-preview {
  margin-top: 22px;
}

.admin-panel-preview h2 {
  margin-top: 0;
  color: #1f1724;
}

.admin-panel-preview p {
  color: #706878;
  line-height: 1.6;
}

/* RESPONSIVE */

@media (max-width: 960px) {
  html,
  body,
  #root {
    overflow: auto;
  }

  .pagina {
    height: auto;
    min-height: 100vh;
    overflow: visible;
  }

  .contenedor {
    height: auto;
    grid-template-columns: 1fr;
    overflow: visible;
  }

  .panel-info {
    height: auto;
    max-height: none;
    overflow: visible;
  }

  .empresa-panel,
  .portal-panel {
    grid-template-columns: 1fr;
    height: auto;
    min-height: 100vh;
    overflow: visible;
  }

  .empresa-sidebar,
  .portal-sidebar {
    height: auto;
  }

  .empresa-main,
  .portal-main {
    height: auto;
    overflow: visible;
  }

  .tienda-preview,
  .section-header,
  .cliente-hero {
    grid-template-columns: 1fr;
    flex-direction: column;
    align-items: flex-start;
  }

  .cliente-grid,
  .admin-cards {
    grid-template-columns: 1fr;
  }

  .producto-detalle {
    grid-template-columns: 1fr;
  }

  .detalle-datos {
    grid-template-columns: 1fr;
  }

  .fila-producto {
    grid-template-columns: 1fr !important;
  }

  .acciones-producto {
    justify-content: flex-start;
  }
}

@media (max-width: 560px) {
  .pagina {
    padding: 18px;
  }

  .panel-info,
  .auth-card {
    padding: 24px;
    border-radius: 26px;
  }

  .grid-dos,
  .form-grid {
    grid-template-columns: 1fr;
  }

  .texto-principal h1 {
    font-size: 38px;
  }

  .info-item {
    grid-template-columns: 1fr;
  }

  .acciones-form {
    flex-direction: column;
  }
}


/* PEDIDOS EMPRESA */

.pedidos-lista {
  display: grid;
  gap: 18px;
}

.pedido-card {
  background: white;
  border: 1px solid #eadce5;
  border-radius: 24px;
  padding: 22px;
  box-shadow: 0 14px 35px rgba(55, 19, 43, 0.06);
  display: grid;
  gap: 18px;
}

.pedido-card-header {
  display: flex;
  justify-content: space-between;
  gap: 18px;
  align-items: flex-start;
  border-bottom: 1px solid #f2dce7;
  padding-bottom: 16px;
}

.pedido-card-header span {
  color: #8f174d;
  font-size: 12px;
  font-weight: 900;
  text-transform: uppercase;
  letter-spacing: 1px;
}

.pedido-card-header h3 {
  margin: 6px 0;
  color: #1f1724;
  font-size: 22px;
}

.pedido-card-header p {
  margin: 0;
  color: #706878;
}

.pedido-estados {
  display: flex;
  flex-wrap: wrap;
  gap: 8px;
  justify-content: flex-end;
}

.estado-badge {
  padding: 9px 12px;
  border-radius: 999px;
  background: #fff1f7;
  color: #8f174d;
  font-size: 12px;
  font-weight: 900;
}

.estado-badge.pago {
  background: #eef2ff;
  color: #3730a3;
}

.pedido-items {
  display: grid;
  gap: 10px;
}

.pedido-item {
  display: flex;
  justify-content: space-between;
  gap: 16px;
  align-items: center;
  padding: 14px;
  border-radius: 16px;
  background: #faf7fb;
}

.pedido-item strong {
  color: #1f1724;
}

.pedido-item p {
  margin: 5px 0 0;
  color: #706878;
  font-size: 13px;
}

.pedido-item span {
  color: #8f174d;
  font-weight: 900;
}

.pedido-footer {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 14px;
}

.pedido-footer div {
  padding: 14px;
  border-radius: 16px;
  background: #fff1f7;
}

.pedido-footer span {
  display: block;
  color: #8f174d;
  font-size: 11px;
  font-weight: 900;
  text-transform: uppercase;
  margin-bottom: 5px;
}

.pedido-footer strong {
  color: #1f1724;
}

@media (max-width: 850px) {
  .pedido-card-header {
    flex-direction: column;
  }

  .pedido-estados {
    justify-content: flex-start;
  }

  .pedido-footer {
    grid-template-columns: 1fr;
  }

  .pedido-item {
    flex-direction: column;
    align-items: flex-start;
  }
}

/* PEDIDOS EMPRESA */

.pedidos-lista {
  display: grid;
  gap: 18px;
}

.pedido-card {
  background: white;
  border: 1px solid #eadce5;
  border-radius: 24px;
  padding: 22px;
  box-shadow: 0 14px 35px rgba(55, 19, 43, 0.06);
  display: grid;
  gap: 18px;
}

.pedido-card-header {
  display: flex;
  justify-content: space-between;
  gap: 18px;
  align-items: flex-start;
  border-bottom: 1px solid #f2dce7;
  padding-bottom: 16px;
}

.pedido-card-header span {
  color: #8f174d;
  font-size: 12px;
  font-weight: 900;
  text-transform: uppercase;
  letter-spacing: 1px;
}

.pedido-card-header h3 {
  margin: 6px 0;
  color: #1f1724;
  font-size: 22px;
}

.pedido-card-header p {
  margin: 0;
  color: #706878;
}

.pedido-estados {
  display: flex;
  flex-wrap: wrap;
  gap: 8px;
  justify-content: flex-end;
}

.estado-badge {
  padding: 9px 12px;
  border-radius: 999px;
  background: #fff1f7;
  color: #8f174d;
  font-size: 12px;
  font-weight: 900;
}

.estado-badge.pago {
  background: #eef2ff;
  color: #3730a3;
}

.pedido-items {
  display: grid;
  gap: 10px;
}

.pedido-item {
  display: flex;
  justify-content: space-between;
  gap: 16px;
  align-items: center;
  padding: 14px;
  border-radius: 16px;
  background: #faf7fb;
}

.pedido-item strong {
  color: #1f1724;
}

.pedido-item p {
  margin: 5px 0 0;
  color: #706878;
  font-size: 13px;
}

.pedido-item span {
  color: #8f174d;
  font-weight: 900;
}

.pedido-footer {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 14px;
}

.pedido-footer div {
  padding: 14px;
